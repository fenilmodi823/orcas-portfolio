---
/**
 * Procedural starfield/nebula background with scroll parallax.
 * Port from fenil-modi-portfolio.html background system.
 */
---

<div class="bg" aria-hidden="true">
  <div class="bg-stars"></div>
  <div class="bg-neb"></div>
  <div class="bg-fil"></div>
  <div class="bg-mark">
    <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="mark-svg">
      <circle cx="100" cy="100" r="60" stroke="currentColor" stroke-width="0.5" opacity="0.3" />
      <ellipse cx="100" cy="100" rx="80" ry="30" stroke="currentColor" stroke-width="0.3" opacity="0.2" transform="rotate(-15 100 100)" />
      <ellipse cx="100" cy="100" rx="70" ry="25" stroke="currentColor" stroke-width="0.3" opacity="0.15" transform="rotate(20 100 100)" />
    </svg>
  </div>
  <div class="bg-veil"></div>
</div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .bg-stars {
    position: absolute;
    inset: -20%;
    background-image: radial-gradient(1px 1px at 10% 20%, rgba(232, 237, 247, 0.6) 50%, transparent 100%),
      radial-gradient(1px 1px at 30% 65%, rgba(232, 237, 247, 0.5) 50%, transparent 100%),
      radial-gradient(1px 1px at 50% 10%, rgba(232, 237, 247, 0.4) 50%, transparent 100%),
      radial-gradient(1px 1px at 70% 80%, rgba(232, 237, 247, 0.5) 50%, transparent 100%),
      radial-gradient(1px 1px at 90% 40%, rgba(232, 237, 247, 0.6) 50%, transparent 100%),
      radial-gradient(0.5px 0.5px at 15% 45%, rgba(232, 237, 247, 0.3) 50%, transparent 100%),
      radial-gradient(0.5px 0.5px at 55% 55%, rgba(232, 237, 247, 0.3) 50%, transparent 100%),
      radial-gradient(0.5px 0.5px at 85% 15%, rgba(232, 237, 247, 0.3) 50%, transparent 100%),
      radial-gradient(1.5px 1.5px at 25% 90%, rgba(232, 237, 247, 0.7) 50%, transparent 100%),
      radial-gradient(1.5px 1.5px at 75% 25%, rgba(232, 237, 247, 0.7) 50%, transparent 100%);
    background-size: 300px 300px;
    will-change: transform;
  }

  .bg-neb {
    position: absolute;
    inset: -40%;
    background: radial-gradient(ellipse 600px 400px at 30% 40%, rgba(0, 229, 255, 0.03), transparent),
      radial-gradient(ellipse 500px 300px at 70% 60%, rgba(0, 229, 255, 0.02), transparent);
    filter: blur(60px);
    will-change: transform;
  }

  .bg-fil {
    position: absolute;
    inset: -10%;
    opacity: 0.04;
    background: repeating-linear-gradient(
      170deg,
      transparent,
      transparent 200px,
      rgba(232, 237, 247, 0.1) 200px,
      rgba(232, 237, 247, 0.1) 201px
    );
    will-change: transform;
  }

  .bg-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 60vmax;
    height: 60vmax;
    transform: translate(-50%, -50%);
    opacity: var(--mark-op, 0.05);
    filter: blur(var(--mark-blur, 0px));
    color: var(--text-xlo);
    transition: opacity var(--t-slow) var(--ease), filter var(--t-slow) var(--ease);
  }

  .mark-svg {
    width: 100%;
    height: 100%;
  }

  .bg-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 0%, var(--void) 100%);
    opacity: 0.3;
  }
</style>

<script>
  const bg = document.querySelector('.bg') as HTMLElement | null;
  if (bg) {
    const stars = bg.querySelector('.bg-stars') as HTMLElement;
    const neb = bg.querySelector('.bg-neb') as HTMLElement;
    const fil = bg.querySelector('.bg-fil') as HTMLElement;

    let ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        const starY = Math.round(y * 0.05);
        const nebY = Math.round(y * 0.02);
        const filY = Math.round(y * 0.08);

        stars.style.transform = `translateY(${starY}px)`;
        neb.style.transform = `translateY(${nebY}px)`;
        fil.style.transform = `translateY(${filY}px)`;

        // Update mark opacity/blur based on scroll position
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const progress = maxScroll > 0 ? y / maxScroll : 0;
        document.documentElement.style.setProperty('--mark-blur', `${progress * 8}px`);
        document.documentElement.style.setProperty('--mark-op', `${0.05 - progress * 0.03}`);

        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // Pause when hidden
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) onScroll();
    });
  }
</script>
