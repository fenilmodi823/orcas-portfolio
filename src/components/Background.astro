---
/**
 * Procedural starfield, nebulae, and architectural ORCAS mark.
 * Direct implementation of design spec §9-§10 and prototype.
 */
---

<div class="bg" aria-hidden="true">
  <div class="bg-stars"></div>
  <div class="bg-neb"></div>
  <div class="bg-fil"></div>

  <!-- Architectural scale ORCAS mark -->
  <svg class="bg-mark" id="bgMark" viewBox="62 45 88 120" data-rate="0.13"><use href="#g-orca"></use></svg>
  <svg class="bg-mark-2" viewBox="62 45 88 120" data-rate="0.09"><use href="#g-orca"></use></svg>

  <div class="bg-veil on"><div class="bg-vign"></div><div class="bg-floor"></div></div>
</div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .bg-stars {
    position: absolute;
    inset: -20%;
    background-image: radial-gradient(1px 1px at 10% 20%, rgba(232, 237, 247, 0.6) 50%, transparent 100%),
      radial-gradient(1px 1px at 30% 65%, rgba(232, 237, 247, 0.5) 50%, transparent 100%),
      radial-gradient(1px 1px at 50% 10%, rgba(232, 237, 247, 0.4) 50%, transparent 100%),
      radial-gradient(1px 1px at 70% 80%, rgba(232, 237, 247, 0.5) 50%, transparent 100%),
      radial-gradient(1px 1px at 90% 40%, rgba(232, 237, 247, 0.6) 50%, transparent 100%),
      radial-gradient(0.5px 0.5px at 15% 45%, rgba(232, 237, 247, 0.3) 50%, transparent 100%),
      radial-gradient(0.5px 0.5px at 55% 55%, rgba(232, 237, 247, 0.3) 50%, transparent 100%),
      radial-gradient(0.5px 0.5px at 85% 15%, rgba(232, 237, 247, 0.3) 50%, transparent 100%),
      radial-gradient(1.5px 1.5px at 25% 90%, rgba(232, 237, 247, 0.7) 50%, transparent 100%),
      radial-gradient(1.5px 1.5px at 75% 25%, rgba(232, 237, 247, 0.7) 50%, transparent 100%);
    background-size: 300px 300px;
    will-change: transform;
  }

  .bg-neb {
    position: absolute;
    inset: -40%;
    background: radial-gradient(ellipse 600px 400px at 30% 40%, rgba(0, 229, 255, 0.04), transparent),
      radial-gradient(ellipse 500px 300px at 70% 60%, rgba(0, 229, 255, 0.025), transparent);
    filter: blur(60px);
    will-change: transform;
  }

  .bg-fil {
    position: absolute;
    inset: -10%;
    opacity: 0.04;
    background: repeating-linear-gradient(
      170deg,
      transparent,
      transparent 200px,
      rgba(232, 237, 247, 0.1) 200px,
      rgba(232, 237, 247, 0.1) 201px
    );
    will-change: transform;
  }

  .bg-mark {
    position: absolute;
    left: 4vw;
    top: 10vh;
    width: min(72vw, 840px);
    height: auto;
    opacity: var(--mark-op, 0.065);
    filter: blur(var(--mark-blur, 0px));
    transition: opacity 1.2s var(--ease);
    will-change: transform, filter;
    --orca-body: var(--cyan);
    --orca-mark: #061021;
  }

  .bg-mark-2 {
    position: absolute;
    left: -15vw;
    top: 160vh;
    width: min(75vw, 850px);
    height: auto;
    opacity: 0.035;
    transform: scaleX(-1) rotate(8deg);
    --orca-body: var(--orca-body-faint);
    --orca-mark: var(--orca-mark-faint);
    filter: blur(2px);
    will-change: transform;
  }

  .bg-veil {
    position: absolute;
    inset: 0;
    opacity: 1;
  }
  .bg-vign {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 120% 78% at 50% 42%, transparent 24%, rgba(4, 7, 15, 0.62) 78%, var(--void) 100%);
  }
  .bg-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34vh;
    background: linear-gradient(to bottom, transparent, var(--void));
  }
</style>

<script>
  const root = document.documentElement;
  const mark1 = document.querySelector('.bg-mark') as HTMLElement | null;
  const mark2 = document.querySelector('.bg-mark-2') as HTMLElement | null;
  const stars = document.querySelector('.bg-stars') as HTMLElement | null;
  const neb = document.querySelector('.bg-neb') as HTMLElement | null;

  const STOPS = [
    { p: 0.0, blur: 0.0, op: 0.075 },
    { p: 0.9, blur: 17, op: 0.03 },
    { p: 2.1, blur: 25, op: 0.02 },
    { p: 3.4, blur: 12, op: 0.034 },
  ];

  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  function curve(p: number) {
    if (p <= STOPS[0].p) return STOPS[0];
    for (let i = 1; i < STOPS.length; i++) {
      if (p <= STOPS[i].p) {
        const a = STOPS[i - 1];
        const b = STOPS[i];
        const t = (p - a.p) / (b.p - a.p);
        return { blur: lerp(a.blur, b.blur, t), op: lerp(a.op, b.op, t) };
      }
    }
    return STOPS[STOPS.length - 1];
  }

  let y = 0;
  let queued = false;
  let lastBlur = -1;

  function frame() {
    queued = false;
    const vh = window.innerHeight || 800;
    const progress = y / vh;

    if (mark1) {
      mark1.style.transform = `translate3d(0, ${(-y * 0.13).toFixed(2)}px, 0)`;
    }
    if (mark2) {
      mark2.style.transform = `scaleX(-1) rotate(8deg) translate3d(0, ${(-y * 0.09).toFixed(2)}px, 0)`;
    }
    if (stars) {
      stars.style.transform = `translate3d(0, ${(y * 0.04).toFixed(2)}px, 0)`;
    }
    if (neb) {
      neb.style.transform = `translate3d(0, ${(y * 0.02).toFixed(2)}px, 0)`;
    }

    const c = curve(progress);
    const blur = Math.round(c.blur);
    if (blur !== lastBlur) {
      root.style.setProperty('--mark-blur', `${blur}px`);
      lastBlur = blur;
    }
    root.style.setProperty('--mark-op', c.op.toFixed(4));
  }

  function onScroll() {
    y = window.scrollY || window.pageYOffset;
    if (!queued) {
      queued = true;
      requestAnimationFrame(frame);
    }
  }

  function initBackground() {
    window.removeEventListener('scroll', onScroll);
    window.removeEventListener('resize', onScroll);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBackground);
  } else {
    initBackground();
  }
  document.addEventListener('astro:page-load', initBackground);
</script>
