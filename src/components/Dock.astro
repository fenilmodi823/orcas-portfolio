---
export interface SectionItem {
  label: string;
  href: string;
}

interface Props {
  sections?: SectionItem[];
}

const { sections = [] } = Astro.props;
---

<div class="dock show" id="dock">
  <button class="dock-bar" id="dockBar" type="button" aria-expanded="false" aria-controls="dockPanel">
    <svg class="dock-mark" viewBox="62 45 88 120" aria-hidden="true"><use href="#g-orca"></use></svg>
    <span class="dock-now">
      <span class="k">Now</span>
      <span class="v" id="dockNow">{sections.length > 0 ? sections[0].label : 'Index'}</span>
    </span>
    <span class="dock-prog" aria-hidden="true"><i id="dockProg"></i></span>
    <svg class="dock-chev" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
      <path d="M1 6 6 1.6 11 6" />
    </svg>
    <span class="sr-only">Toggle section index</span>
  </button>
  {sections.length > 0 && (
    <div class="dock-panel" id="dockPanel">
      <nav class="dock-grid" id="dockGrid">
        {sections.map((sec, i) => (
          <a href={sec.href} class="dock-link" data-index={i}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span class="t">{sec.label}</span>
          </a>
        ))}
      </nav>
    </div>
  )}
</div>

<style>
  .dock {
    position: fixed;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    z-index: 95;
    width: min(92vw, 520px);
    background: var(--glass-fill);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-panel);
    overflow: hidden;
    opacity: 1;
    pointer-events: auto;
    transition: transform var(--t-base) var(--ease), box-shadow var(--t-fast) var(--ease);
  }
  .dock:hover {
    border-color: rgba(0, 229, 255, 0.25);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
  }
  .dock.hide {
    transform: translateX(-50%) translateY(140%);
  }
  .dock-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 11px 14px 11px 16px;
    cursor: pointer;
    user-select: none;
    width: 100%;
    background: none;
    border: 0;
    color: inherit;
    text-align: left;
    font: inherit;
  }
  .dock-bar:hover {
    background: rgba(232, 237, 247, 0.04);
  }
  .dock-mark {
    width: 16px;
    height: auto;
    flex: none;
    --orca-body: var(--cyan);
    --orca-mark: transparent;
  }
  .dock-now {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    overflow: hidden;
  }
  .dock-now .k {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-xlo);
    flex: none;
  }
  .dock-now .v {
    font-size: 13px;
    color: var(--text-hi);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dock-prog {
    width: 54px;
    height: 3px;
    background: rgba(232, 237, 247, 0.15);
    border-radius: 2px;
    flex: none;
    overflow: hidden;
    position: relative;
  }
  .dock-prog i {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--cyan);
    border-radius: 2px;
    box-shadow: 0 0 6px var(--cyan);
    transition: width 60ms linear;
  }
  .dock-chev {
    width: 11px;
    height: 8px;
    flex: none;
    color: var(--text-lo);
    transition: transform var(--t-base) var(--ease);
  }
  .dock.open .dock-chev {
    transform: rotate(180deg);
  }
  .dock-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--t-slow) var(--ease);
  }
  .dock.open .dock-panel {
    max-height: 60vh;
    overflow-y: auto;
  }
  .dock-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    padding: 4px 8px 10px;
    border-top: 1px solid var(--line);
    max-height: 60vh;
  }
  .dock-grid a {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 9px 10px;
    border-radius: var(--r-cell);
    text-decoration: none;
    transition: background var(--t-fast) var(--ease);
  }
  .dock-grid a:hover {
    background: rgba(232, 237, 247, 0.06);
  }
  .dock-grid a.on {
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid rgba(0, 229, 255, 0.2);
  }
  .dock-grid .n {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    color: var(--text-xlo);
    flex: none;
    width: 16px;
  }
  .dock-grid a.on .n {
    color: var(--cyan);
  }
  .dock-grid .t {
    font-size: 13px;
    color: var(--text);
  }
  .dock-grid a:hover .t,
  .dock-grid a.on .t {
    color: var(--text-hi);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 720px) {
    .dock {
      width: calc(100vw - 24px);
      bottom: 12px;
    }
  }

  @media (max-width: 520px) {
    .dock-grid {
      grid-template-columns: 1fr;
    }
    .dock-bar {
      padding: 9px 12px;
      gap: 10px;
    }
    .dock-prog {
      width: 40px;
    }
  }
</style>

<script>
  function initDock() {
    const dock = document.getElementById('dock');
    const dockBar = document.getElementById('dockBar');
    const dockProg = document.getElementById('dockProg');
    const dockNow = document.getElementById('dockNow');
    const dockLinks = document.querySelectorAll<HTMLAnchorElement>('.dock-link');

    if (!dock || !dockBar) return;

    dockBar.onclick = (e) => {
      e.stopPropagation();
      const isOpen = dock.classList.toggle('open');
      dockBar.setAttribute('aria-expanded', String(isOpen));
    };

    document.addEventListener('click', (e) => {
      if (dock.classList.contains('open') && !dock.contains(e.target as Node)) {
        dock.classList.remove('open');
        dockBar.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dock.classList.contains('open')) {
        dock.classList.remove('open');
        dockBar.setAttribute('aria-expanded', 'false');
        dockBar.focus();
      }
    });

    dockLinks.forEach((link) => {
      link.onclick = (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          const targetEl = document.querySelector(href);
          if (targetEl) {
            e.preventDefault();
            targetEl.scrollIntoView({ behavior: 'smooth' });
          }
        }
        dock.classList.remove('open');
        dockBar.setAttribute('aria-expanded', 'false');
      };
    });

    // Scroll progress & section detection
    const sectionEls = Array.from(document.querySelectorAll<HTMLElement>('section[id], [data-sec]'));

    function updateDock() {
      const scrollTop = window.scrollY || window.pageYOffset || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
      
      if (dockProg) {
        dockProg.style.width = `${progress.toFixed(1)}%`;
      }

      for (let i = sectionEls.length - 1; i >= 0; i--) {
        const el = sectionEls[i];
        const rect = el.getBoundingClientRect();
        if (rect.top <= window.innerHeight * 0.45) {
          if (dockNow) {
            const heading = el.querySelector('h1, h2, h3');
            dockNow.textContent = el.dataset.sec || heading?.textContent?.trim() || el.id;
          }
          dockLinks.forEach((link) => {
            const href = link.getAttribute('href');
            link.classList.toggle('on', href === `#${el.id}`);
          });
          break;
        }
      }
    }

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            updateDock();
            ticking = false;
          });
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', updateDock, { passive: true });
    updateDock();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDock);
  } else {
    initDock();
  }
  document.addEventListener('astro:page-load', initDock);
</script>
