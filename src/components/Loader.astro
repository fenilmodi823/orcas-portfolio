  </div>
</div>

<noscript>
  <style>
    #loader {
      display: none;
    }
  </style>
</noscript>

<style>
  #loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--void);
    display: grid;
    place-items: center;
    transition:
      opacity 800ms var(--ease),
      visibility 800ms;
  }
  #loader.done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .load-wrap {
    display: grid;
    place-items: center;
    gap: 34px;
    transform: translateY(-2vh);
  }
  .load-art {
    width: clamp(150px, 20vw, 208px);
    --orca-body: var(--cyan);
    --orca-mark: var(--void);
  }

  /* the ring draws, the waves ripple outward, the body surfaces */
  .load-art .lr {
    stroke-dasharray: var(--len, 900);
    stroke-dashoffset: var(--len, 900);
    animation: load-draw 1500ms var(--ease-io) 120ms forwards;
  }
  .load-art .lw {
    opacity: 0;
    animation: load-wave 900ms var(--ease) forwards;
  }
  .load-art .lw1 {
    animation-delay: 820ms;
  }
  .load-art .lw2 {
    animation-delay: 940ms;
  }
  .load-art .lw3 {
    animation-delay: 1060ms;
  }
  .load-art .lb {
    opacity: 0;
    transform: translateY(9px) scale(0.985);
    transform-origin: 52% 58%;
    animation: load-surface 1000ms var(--ease) 420ms forwards;
  }
  @keyframes load-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes load-wave {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 0.6;
      transform: none;
    }
  }
  @keyframes load-surface {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .load-word {
    width: 132px;
    opacity: 0;
    color: var(--text-hi);
    animation: load-fade 700ms var(--ease) 1150ms forwards;
  }
  .load-meta {
    opacity: 0;
    animation: load-fade 700ms var(--ease) 1380ms forwards;
    display: flex;
    gap: 14px;
    align-items: center;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-lo);
  }
  @keyframes load-fade {
    to {
      opacity: 1;
    }
  }
  .load-bar {
    width: 78px;
    height: 1px;
    background: var(--line-hi);
    position: relative;
    overflow: hidden;
  }
  .load-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--cyan);
    transform: translateX(-100%);
    animation: load-sweep 1500ms var(--ease-io) 1380ms infinite;
  }
  @keyframes load-sweep {
    to {
      transform: translateX(100%);
    }
  }
</style>

<script>
  const el = document.getElementById('loader');
  if (el) {
    const ring = document.getElementById('ring-path') as SVGPathElement | null;
    if (ring) {
      const len = Math.ceil(ring.getTotalLength());
      ring.style.setProperty('--len', String(len));
    }

    const pctEl = document.getElementById('loadPct');
    let p = 0;
    const tick = window.setInterval(() => {
      p = Math.min(99, p + Math.random() * 17);
      if (pctEl) pctEl.textContent = String(Math.floor(p)).padStart(2, '0');
    }, 130);

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const MIN = reduced ? 200 : 2150;
    const t0 = performance.now();

    const finish = () => {
      clearInterval(tick);
      if (pctEl) pctEl.textContent = '100';
      const wait = Math.max(0, MIN - (performance.now() - t0));
      setTimeout(() => el.classList.add('done'), wait);
    };

    if (document.readyState === 'complete') finish();
    else window.addEventListener('load', finish, { once: true });
    setTimeout(finish, 6000); // never trap a visitor behind a slow font/asset
  }
</script>
