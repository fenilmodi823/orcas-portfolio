---
---

<div class="sim">
  <div class="sim-stage" id="simStage">
    <canvas id="simCanvas"></canvas>
    <div class="sim-hud">
      <div class="sim-badge mono">
        <span class="pulse-dot"></span>
        <span id="simView">Earth-centric</span>
      </div>
      <div class="sim-epoch mono" id="simEpoch">T+00000.0s</div>
    </div>
  </div>

  <div class="sim-dock">
    <div class="sim-sel">
      <span class="k mono">Selected Object</span>
      <span class="v" id="simName">ISS (ZARYA)</span>
    </div>
    <div class="sim-els mono" id="simEls">
      <!-- Injected by script -->
    </div>
    <div class="sim-ctl">
      <div class="sim-rate">
        <button class="rate-btn on" data-rate="60">1×</button>
        <button class="rate-btn" data-rate="300">5×</button>
        <button class="rate-btn" data-rate="1800">30×</button>
      </div>
      <button class="sim-btn" id="simReset" title="Reset Camera">
        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="sim-legend mono">
    <span><i style="background: var(--cyan-lift);"></i> LEO / SSO</span>
    <span><i style="background: var(--regime-meo);"></i> MEO</span>
    <span><i style="background: var(--regime-geo);"></i> GEO</span>
    <span><i style="background: var(--regime-heo);"></i> HEO</span>
  </div>

  <p class="sim-caveat mono">
    Honest scope note: two-body Keplerian propagation, no perturbations, representative elements rather than live TLEs. The production ORCAS engine uses SGP4/SDP4 with covariance propagation.
  </p>
</div>

<style>
  .sim {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    overflow: hidden;
    background: rgba(5, 9, 18, 0.5);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    margin: clamp(24px, 4vw, 40px) 0;
    padding-bottom: 16px;
  }
  .sim-stage {
    position: relative;
    width: 100%;
    height: clamp(340px, 54svh, 600px);
    cursor: grab;
    touch-action: none;
  }
  .sim-stage:active {
    cursor: grabbing;
  }
  .sim-stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .sim-hud {
    position: absolute;
    top: 16px;
    left: 18px;
    right: 18px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    pointer-events: none;
    flex-wrap: wrap;
  }
  .sim-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
    animation: sim-pulse 1.8s var(--ease-io) infinite;
  }
  .sim-epoch {
    font-size: 11px;
    color: var(--text-lo);
    letter-spacing: 0.1em;
  }
  .sim-dock {
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 26px);
    padding: 12px clamp(14px, 2vw, 20px);
    flex-wrap: wrap;
  }
  .sim-sel {
    flex: 1;
    min-width: 160px;
    display: grid;
    gap: 3px;
  }
  .sim-sel .k {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-xlo);
  }
  .sim-sel .v {
    font-size: 14px;
    color: var(--text-hi);
    font-weight: 300;
  }
  .sim-els {
    display: flex;
    gap: clamp(10px, 1.6vw, 22px);
    flex-wrap: wrap;
  }
  :global(.sim-els div) {
    display: grid;
    gap: 3px;
  }
  :global(.sim-els .k) {
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-xlo);
  }
  :global(.sim-els .v) {
    font-size: 12px;
    color: var(--text);
  }
  .sim-ctl {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }
  .sim-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    background: none;
    color: var(--text-lo);
    cursor: pointer;
    transition: all var(--t-fast) var(--ease);
  }
  .sim-btn:hover {
    color: var(--text-hi);
    border-color: var(--line-hi);
  }
  .sim-rate {
    display: flex;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    overflow: hidden;
  }
  .sim-rate button {
    background: none;
    border: 0;
    cursor: pointer;
    padding: 6px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--text-lo);
    transition: all var(--t-fast) var(--ease);
  }
  .sim-rate button:hover {
    color: var(--text-hi);
  }
  .sim-rate button.on {
    color: var(--cyan);
    background: rgba(0, 229, 255, 0.09);
  }
  .sim-legend {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    padding: 12px 20px 0;
  }
  .sim-legend span {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-lo);
  }
  .sim-legend i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }
  .sim-caveat {
    padding: 8px 20px 0;
    font-size: 11px;
    color: var(--text-xlo);
    line-height: 1.6;
    margin: 0;
  }

  @keyframes sim-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.8);
    }
  }

  @media (max-width: 720px) {
    .sim-stage {
      height: clamp(280px, 46svh, 400px);
    }
    .sim-dock {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }
    .sim-ctl {
      margin-left: 0;
      width: 100%;
      justify-content: space-between;
    }
    .sim-els {
      gap: 12px 18px;
    }
  }
</style>

<script>
  import { CATALOG, propagateEci, type OrbitalElements } from '@/lib/orbital';

  function initMiniSimulation() {
    const cv = document.getElementById('simCanvas') as HTMLCanvasElement;
    const stage = document.getElementById('simStage') as HTMLElement;
    const epochEl = document.getElementById('simEpoch');
    const viewEl = document.getElementById('simView');
    const nameEl = document.getElementById('simName');
    const elsEl = document.getElementById('simEls');
    const resetBtn = document.getElementById('simReset');
    const rateBtns = document.querySelectorAll('.rate-btn');

    if (!cv || !stage) return;

    const ctx = cv.getContext('2d')!;
    const RE = 6371;
    const D2R = Math.PI / 180;

    const SATS = CATALOG;
    const HOME = { az: -0.6, el: 0.42, d: 118000 };

    // Resolved once from tokens.css so canvas fillStyle/strokeStyle (which can't take var()) stays in sync with the design system.
    const rootStyle = getComputedStyle(document.documentElement);
    const tok = (name: string) => rootStyle.getPropertyValue(name).trim();
    const CYAN = tok('--cyan');
    const REGIME_COLORS: Record<string, string> = {
      LEO: tok('--cyan-lift'),
      SSO: tok('--cyan-lift'),
      MEO: tok('--regime-meo'),
      GEO: tok('--regime-geo'),
      HEO: tok('--regime-heo'),
    };
    let cam = { ...HOME };
    let tgt = [0, 0, 0];
    let tgtWant = [0, 0, 0];
    let W = 0,
      H = 0,
      DPR = 1,
      cx = 0,
      cy = 0,
      f = 1;
    let t = 0;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let rate = reduceMotion ? 0 : 60; // an explicit rate-button click still animates on request
    let sel = 0; // Select ISS by default

    function resize() {
      const b = stage.getBoundingClientRect();
      if (!b.width || !b.height) return;
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = b.width;
      H = b.height;
      cv.width = Math.round(W * DPR);
      cv.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      cx = W / 2;
      cy = H / 2;
      f = Math.min(W, H) * 0.92;
    }
    resize();
    window.addEventListener('resize', resize);

    function proj(p: [number, number, number]): [number, number, number] | null {
      const x = p[0] - tgt[0];
      const y = p[1] - tgt[1];
      const z = p[2] - tgt[2];
      const ca = Math.cos(cam.az),
        sa = Math.sin(cam.az);
      const x1 = x * ca + y * sa,
        y1 = -x * sa + y * ca;
      const ce = Math.cos(cam.el),
        se = Math.sin(cam.el);
      const y2 = y1 * ce + z * se,
        z2 = -y1 * se + z * ce;
      const depth = cam.d - y2;
      if (depth < 1) return null;
      const k = (f / depth) * (cam.d / 40000);
      return [cx + x1 * k, cy - z2 * k, depth];
    }

    function sphere(lat: number, lon: number, gmst: number): [number, number, number] {
      const la = lat * D2R,
        lo = lon * D2R + gmst;
      const cl = Math.cos(la);
      return [RE * cl * Math.cos(lo), RE * cl * Math.sin(lo), RE * Math.sin(la)];
    }

    function updateEls(s: OrbitalElements | null) {
      if (!elsEl) return;
      if (!s) {
        elsEl.innerHTML = '';
        return;
      }
      const rows = [
        ['a', s.aKm.toLocaleString() + ' km'],
        ['e', s.e.toFixed(4)],
        ['i', s.incDeg.toFixed(1) + '°'],
        ['Period', s.periodMin.toFixed(1) + ' min'],
        ['Regime', s.regime],
      ];
      elsEl.innerHTML = rows.map(([k, v]) => `<div><span class="k">${k}</span><span class="v">${v}</span></div>`).join('');
    }

    function select(i: number) {
      sel = i;
      if (i < 0) {
        if (nameEl) nameEl.textContent = 'None — click an object';
        updateEls(null);
        tgtWant = [0, 0, 0];
        if (viewEl) viewEl.textContent = 'Earth-centric';
      } else {
        const s = SATS[i];
        if (nameEl) nameEl.textContent = s.name;
        updateEls(s);
        if (viewEl) viewEl.textContent = 'Object-centric';
      }
    }

    select(0); // Initial ISS select

    // Drag camera rotation
    let dragging = false,
      lastMouse = [0, 0];
    stage.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastMouse = [e.clientX, e.clientY];
      stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastMouse[0];
      const dy = e.clientY - lastMouse[1];
      cam.az += dx * 0.006;
      cam.el = Math.max(-1.4, Math.min(1.4, cam.el + dy * 0.006));
      lastMouse = [e.clientX, e.clientY];
    });
    stage.addEventListener('pointerup', () => (dragging = false));
    stage.addEventListener('pointercancel', () => (dragging = false));

    // Mouse click selection
    const screenPts: { x: number; y: number; idx: number }[] = [];
    stage.addEventListener('click', (e) => {
      const rect = stage.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      let clicked = -1;
      let minDist = 22;
      for (const pt of screenPts) {
        const dist = Math.hypot(pt.x - mx, pt.y - my);
        if (dist < minDist) {
          minDist = dist;
          clicked = pt.idx;
        }
      }
      if (clicked >= 0) {
        select(clicked);
      }
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        cam = { ...HOME };
        select(-1);
      });
    }

    rateBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        rateBtns.forEach((b) => b.classList.remove('on'));
        btn.classList.add('on');
        rate = Number(btn.getAttribute('data-rate')) || 60;
      });
    });

    let lastFrame = performance.now();
    let loopRunning = false;

    function startLoop() {
      if (loopRunning) return;
      loopRunning = true;
      lastFrame = performance.now(); // avoid a huge dt jump from time spent paused
      requestAnimationFrame(renderLoop);
    }

    // Nothing on screen to see and nothing worth redrawing — stop burning frames.
    if ('IntersectionObserver' in window) {
      const visibilityObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries[0]?.isIntersecting ?? true;
          if (visible) startLoop();
          else loopRunning = false;
        },
        { threshold: 0 },
      );
      visibilityObserver.observe(stage);
    } else {
      startLoop();
    }

    function renderLoop(now: number) {
      if (!loopRunning) return;
      const dt = Math.min((now - lastFrame) / 1000, 0.1);
      lastFrame = now;
      t += dt * rate;

      if (epochEl) {
        epochEl.textContent = `T+${Math.floor(t).toString().padStart(5, '0')}s`;
      }

      ctx.clearRect(0, 0, W, H);
      const gmst = (t / 86164.0905) * 2 * Math.PI;

      if (sel >= 0) {
        const pos = propagateEci(SATS[sel], t);
        tgtWant = [pos.x, pos.y, pos.z];
      }
      for (let k = 0; k < 3; k++) {
        tgt[k] += (tgtWant[k] - tgt[k]) * 0.08;
      }

      // Earth: atmosphere glow ring, once per frame (cheap — closed-form circle, no per-point blur)
      const earthCenter = proj([0, 0, 0]);
      const sphereR = (f / 40000) * RE;
      if (earthCenter) {
        const [ecx, ecy] = earthCenter;
        const glow = ctx.createRadialGradient(ecx, ecy, sphereR * 0.82, ecx, ecy, sphereR * 1.4);
        glow.addColorStop(0, 'rgba(0, 229, 255, 0.22)');
        glow.addColorStop(1, 'rgba(0, 229, 255, 0)');
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(ecx, ecy, sphereR * 1.4, 0, Math.PI * 2);
        ctx.fill();

        ctx.shadowBlur = 10;
        ctx.shadowColor = 'rgba(0, 229, 255, 0.6)';
        ctx.strokeStyle = 'rgba(150, 220, 240, 0.5)';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.arc(ecx, ecy, sphereR, 0, Math.PI * 2);
        ctx.stroke();
        ctx.shadowBlur = 0;
      }

      // Earth: dot-matrix sphere. Backface-culled (y2 <= 0 is the far hemisphere)
      // so it reads as a solid globe rather than the old X-ray wireframe.
      const ca = Math.cos(cam.az),
        sa = Math.sin(cam.az);
      const ce = Math.cos(cam.el),
        se = Math.sin(cam.el);
      for (let lat = -84; lat <= 84; lat += 6) {
        for (let lon = 0; lon < 360; lon += 7) {
          const world = sphere(lat, lon, gmst);
          const x = world[0] - tgt[0],
            y = world[1] - tgt[1],
            z = world[2] - tgt[2];
          const y1 = -x * sa + y * ca;
          const y2 = y1 * ce + z * se;
          if (y2 <= 0) continue; // far side, culled
          const p = proj(world);
          if (!p) continue;
          const limb = 1 - Math.min(1, y2 / RE); // 0 = facing camera, 1 = at the limb
          ctx.beginPath();
          ctx.fillStyle = `rgba(150, 210, 235, ${(0.14 + limb * 0.5).toFixed(2)})`;
          ctx.arc(p[0], p[1], 0.6 + limb * 0.8, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // Orbits & Satellites
      screenPts.length = 0;
      SATS.forEach((sat, idx) => {
        const isSelected = sel === idx;
        const color = REGIME_COLORS[sat.regime] || CYAN;

        // Orbit ellipse trail — glowing, colored by the satellite's real regime
        // (the "arc" equivalent: information-bearing, not decorative)
        ctx.beginPath();
        ctx.strokeStyle = isSelected ? 'rgba(0, 229, 255, 0.55)' : 'rgba(232, 237, 247, 0.12)';
        ctx.lineWidth = isSelected ? 1.2 : 0.8;
        ctx.shadowBlur = isSelected ? 8 : 4;
        ctx.shadowColor = color;
        const steps = 60;
        let on = false;
        for (let s = 0; s <= steps; s++) {
          const ptTime = (s / steps) * (sat.periodMin * 60);
          const pEci = propagateEci(sat, ptTime);
          const pScreen = proj([pEci.x, pEci.y, pEci.z]);
          if (!pScreen) {
            on = false;
            continue;
          }
          if (on) ctx.lineTo(pScreen[0], pScreen[1]);
          else {
            ctx.moveTo(pScreen[0], pScreen[1]);
            on = true;
          }
        }
        ctx.stroke();
        ctx.shadowBlur = 0;

        // Current Satellite Position
        const curEci = propagateEci(sat, t);
        const curScreen = proj([curEci.x, curEci.y, curEci.z]);
        if (curScreen) {
          screenPts.push({ x: curScreen[0], y: curScreen[1], idx });

          ctx.beginPath();
          ctx.arc(curScreen[0], curScreen[1], isSelected ? 4.5 : 2.8, 0, Math.PI * 2);
          ctx.fillStyle = isSelected ? CYAN : color;
          ctx.fill();

          if (isSelected) {
            ctx.beginPath();
            ctx.arc(curScreen[0], curScreen[1], 9, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(0, 229, 255, 0.5)';
            ctx.stroke();
          }

          // Label
          ctx.font = '10px "JetBrains Mono", monospace';
          ctx.fillStyle = isSelected ? '#ffffff' : 'rgba(232, 237, 247, 0.6)';
          ctx.fillText(sat.name.split(' ')[0], curScreen[0] + 8, curScreen[1] + 3);
        }
      });

      if (loopRunning) requestAnimationFrame(renderLoop);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMiniSimulation);
  } else {
    initMiniSimulation();
  }
  document.addEventListener('astro:page-load', initMiniSimulation);
</script>
