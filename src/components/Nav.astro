---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<nav class="nav" id="nav">
  <a class="nav-mark" href="/" aria-label="ORCAS — Home">
    <svg class="m" viewBox="62 45 88 120"><use href="#g-orca"></use></svg>
    <svg class="w" viewBox="0 -80 408 86"><use href="#g-word"></use></svg>
  </a>
  <div class="nav-links">
    <a href="/" class:list={[{ on: currentPath === '/' }]}>Home</a>
    <a href="/research" class:list={[{ on: currentPath === '/research' }]}>Research</a>
    <a href="/projects" class:list={[{ on: currentPath.startsWith('/projects') }]}>Projects</a>
    <a href="/cv" class:list={[{ on: currentPath === '/cv' }]}>CV</a>
    <a href="#contact" class="cta" id="navContactBtn">Contact</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px var(--gutter);
    transition: transform var(--t-base) var(--ease), background var(--t-slow) var(--ease);
  }
  .nav.hide {
    transform: translateY(-104%);
  }
  .nav-mark {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
  }
  .nav-mark svg.m {
    width: 19px;
    height: auto;
    --orca-body: var(--cyan);
    --orca-mark: var(--void);
  }
  .nav-mark svg.w {
    width: 66px;
    height: auto;
    color: var(--text-hi);
    opacity: 0.9;
  }
  .nav-links {
    display: flex;
    gap: 4px;
    align-items: center;
    background: var(--glass-fill);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-pill);
    padding: 5px 6px;
  }
  .nav-links a {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--text);
    padding: 7px 15px;
    border-radius: var(--r-pill);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .nav-links a:hover {
    color: var(--text-hi);
    background: rgba(232, 237, 247, 0.05);
  }
  .nav-links a.on {
    color: var(--text-hi);
    background: rgba(232, 237, 247, 0.08);
  }
  .nav-links a.cta {
    color: var(--cyan);
  }
  .nav-links a.cta:hover {
    background: rgba(0, 229, 255, 0.09);
  }

  @media (max-width: 720px) {
    .nav {
      padding: 12px 16px;
    }
    .nav-links a {
      padding: 6px 9px;
      font-size: 11px;
    }
  }

  @media (max-width: 480px) {
    .nav {
      padding: 10px 12px;
    }
    .nav-mark svg.w {
      display: none;
    }
    .nav-links {
      gap: 2px;
      padding: 3px 4px;
    }
    .nav-links a {
      padding: 5px 7px;
      font-size: 10.5px;
    }
  }

  @media (max-width: 360px) {
    .nav-links a {
      padding: 4px 5px;
      font-size: 10px;
    }
  }
</style>

<script>
  function initNav() {
    let lastY = 0;
    const nav = document.getElementById('nav');
    const contactBtn = document.getElementById('navContactBtn');

    function onScroll() {
      const y = window.scrollY;
      if (nav) {
        if (y > 260 && y > lastY) {
          nav.classList.add('hide');
        } else {
          nav.classList.remove('hide');
        }
      }
      lastY = y;
    }

    window.removeEventListener('scroll', onScroll);
    window.addEventListener('scroll', onScroll, { passive: true });

    if (contactBtn) {
      contactBtn.onclick = (e) => {
        const contactEl = document.getElementById('contact');
        if (contactEl) {
          e.preventDefault();
          contactEl.scrollIntoView({ behavior: 'smooth' });
          const emailLink = contactEl.querySelector<HTMLAnchorElement>('.email-link');
          if (emailLink) {
            emailLink.focus();
          }
        }
      };
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav);
  } else {
    initNav();
  }
  document.addEventListener('astro:page-load', initNav);
</script>
