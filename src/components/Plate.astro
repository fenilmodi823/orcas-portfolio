---
import { LINKS } from '@/data/links';
---

<section class="plate-sec" id="contact" data-sec="Contact">
  <div class="wrap">
    <div class="plate-intro">
      <div>
        <div class="eyebrow"><span class="mono">Plate 01</span></div>
        <h2 class="h2">A record of where everything was.</h2>
      </div>
      <div class="plate-legend mono" id="plateLegend" role="group" aria-label="Orbital shell filters">
        <button type="button" class="legend-btn" data-shell="LEO" aria-pressed="false">
          <span class="sw cy"></span><span>Low Earth orbit · 550 km</span>
        </button>
        <button type="button" class="legend-btn" data-shell="MEO" aria-pressed="false">
          <span class="sw dash meo"></span><span>Medium Earth orbit · 20 200 km</span>
        </button>
        <button type="button" class="legend-btn" data-shell="GEO" aria-pressed="false">
          <span class="sw dash geo"></span><span>Geostationary · 35 786 km</span>
        </button>
        <button type="button" class="legend-btn" data-shell="FAN" aria-pressed="false">
          <span class="sw"></span><span>Inclination fan · degrees</span>
        </button>
      </div>
    </div>
  </div>

  <div class="plate-stage">
    <div class="plate" id="mainPlate">
      <svg viewBox="0 0 1000 1000" role="img" aria-label="The ORCAS Plate — orbital shells, inclination fan and catalogue marks">
        <defs>
          <path id="ringTextA" fill="none" d="M500 68 a432 432 0 1 1 -.1 0"></path>
          <!-- counter-clockwise so the lower band reads right-way-up -->
          <path id="ringTextB" fill="none" d="M500 906 a406 406 0 1 0 -.1 0"></path>
          <radialGradient id="coreG" cx="40%" cy="34%">
            <stop offset="0" style="stop-color: #0d2847"></stop>
            <stop offset=".6" style="stop-color: #071324"></stop>
            <stop offset="1" style="stop-color: var(--void)"></stop>
          </radialGradient>
        </defs>

        <!-- rim + tick band, turning -->
        <g class="turn">
          <circle class="etch-hi" cx="500" cy="500" r="468"></circle>
          <circle class="etch" cx="500" cy="500" r="452"></circle>
          <g id="rimTicks"></g>
        </g>

        <!-- annotation band -->
        <text class="lbl-xs">
          <textPath href="#ringTextA" startOffset="0">
            ORCAS · ORBITAL RISK AND CONJUNCTION ASSESSMENT SYSTEM · EVERY OBJECT ABOVE EARTH, PROPAGATED · SGP4 / SDP4 · PLATE 01 OF 01 ·
          </textPath>
        </text>
        <text class="lbl-xs">
          <textPath href="#ringTextB" startOffset="0">
            THE CATALOGUE IS PUBLIC · THE SKY IS NOT LEGIBLE WITHOUT IT · BUILT BY FENIL MODI · MMXXVI ·
          </textPath>
        </text>

        <!-- shells -->
        <circle class="etch shell-geo" data-shell="GEO" cx="500" cy="500" r="372" stroke-dasharray="5 9"></circle>
        <circle class="etch shell-meo" data-shell="MEO" cx="500" cy="500" r="288" stroke-dasharray="5 9"></circle>
        <circle class="etch-cy shell-leo" data-shell="LEO" cx="500" cy="500" r="198"></circle>

        <!-- inclination fan -->
        <g id="fan" data-shell="FAN"></g>

        <!-- two eccentric paths across the shells -->
        <ellipse class="etch" cx="500" cy="428" rx="180" ry="330" transform="rotate(-24 500 500)" opacity=".7"></ellipse>
        <ellipse class="etch" cx="500" cy="556" rx="330" ry="126" transform="rotate(16 500 500)" opacity=".55"></ellipse>

        <!-- catalogue marks, counter-turning -->
        <g class="turn-r" id="cat"></g>

        <!-- Earth -->
        <circle cx="500" cy="500" r="108" fill="url(#coreG)"></circle>
        <circle class="etch-cy" cx="500" cy="500" r="108" opacity=".45"></circle>
        <g class="etch" opacity=".45">
          <ellipse cx="500" cy="500" rx="108" ry="38"></ellipse>
          <ellipse cx="500" cy="500" rx="108" ry="76"></ellipse>
          <ellipse cx="500" cy="500" rx="42" ry="108"></ellipse>
          <ellipse cx="500" cy="500" rx="80" ry="108"></ellipse>
        </g>

        <!-- rim annotations, fixed -->
        <text class="lbl" x="500" y="26" text-anchor="middle">00h</text>
        <text class="lbl" x="988" y="504" text-anchor="end">06h</text>
        <text class="lbl" x="500" y="988" text-anchor="middle">12h</text>
        <text class="lbl" x="12" y="504">18h</text>

        <text class="lbl lbl-cy lbl-leo" data-shell="LEO" x="500" y="292" text-anchor="middle">LEO</text>
        <text class="lbl lbl-meo" data-shell="MEO" x="500" y="202" text-anchor="middle">MEO</text>
        <text class="lbl lbl-geo" data-shell="GEO" x="500" y="118" text-anchor="middle">GEO</text>
      </svg>
      <div class="plate-core">
        <svg viewBox="62 45 88 120"><use href="#g-orca"></use></svg>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="foot">
    <div class="wrap">
      <div class="foot-rows">
        <div class="foot-col transmit-col">
          <h4>Transmit</h4>
          <a href={LINKS.email} class="email-link" id="footerEmailLink" title="Click to email or copy address">
            {LINKS.email.replace('mailto:', '')}
            <span class="copy-badge" id="emailCopyBadge">Copied ✓</span>
          </a>
          <p class="foot-desc">
            Open to collaboration on orbital tooling, 3D interfaces, and anything that makes public space data usable.
          </p>
        </div>
        <div class="foot-col">
          <h4>Elsewhere</h4>
          <a href={LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={LINKS.x} target="_blank" rel="noopener noreferrer">X / Twitter</a>
          <a href={LINKS.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
        <div class="foot-col">
          <h4>Routes</h4>
          <a href="/">Home</a>
          <a href="/research">Research</a>
          <a href="/projects">Projects</a>
          <a href="/cv">CV & Résumé</a>
        </div>
        <div class="foot-col">
          <h4>Colophon</h4>
          <span class="mono colophon-text">
            Plus Jakarta Sans<br />
            JetBrains Mono<br />
            Built with Astro 7
          </span>
        </div>
      </div>
    </div>

    <!-- Interactive Dot Matrix ORCAS Footer Stage -->
    <div class="foot-big foot-matrix-stage" id="footMatrixStage" aria-label="Interactive ORCAS dot matrix logo">
      <canvas id="footMatrixCanvas" class="foot-matrix-canvas"></canvas>
    </div>

    <!-- Metadata line overlaid directly on the bottom part of the ORCAS wordmark -->
    <div class="wrap foot-base mono">
      <span>© <span id="yr">2026</span> Fenil Modi</span>
      <span>Plate 01 · <span id="epochFoot">2026-08-21</span> UTC</span>
    </div>
  </footer>
</section>

<style>
  .plate-sec {
    position: relative;
    width: 100%;
    padding-top: clamp(24px, 4vh, 56px);
    padding-bottom: 0;
    overflow: hidden;
  }
  .plate-intro {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
    margin-bottom: clamp(30px, 5vw, 58px);
  }
  .plate-intro .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .plate-intro .eyebrow::before {
    content: '';
    width: 22px;
    height: 1px;
    background: var(--cyan);
    opacity: 0.55;
  }
  .plate-intro h2 {
    font-size: clamp(1.9rem, 3.4vw, 3.1rem);
    font-weight: 200;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text-hi);
    margin: 0;
    max-width: 16ch;
  }

  .plate-legend {
    display: grid;
    gap: 6px;
    min-width: 260px;
  }
  .legend-btn {
    display: flex;
    align-items: center;
    gap: 11px;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--r-cell);
    padding: 6px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-lo);
    cursor: pointer;
    text-align: left;
    transition: all var(--t-fast) var(--ease);
    width: 100%;
    user-select: none;
  }
  .legend-btn:hover {
    background: rgba(232, 237, 247, 0.05);
    color: var(--text-hi);
    border-color: rgba(232, 237, 247, 0.15);
  }
  .legend-btn.active {
    background: rgba(0, 229, 255, 0.09);
    color: var(--cyan);
    border-color: rgba(0, 229, 255, 0.4);
    box-shadow: 0 0 12px rgba(0, 229, 255, 0.15);
  }
  .legend-btn .sw {
    width: 16px;
    height: 1px;
    background: var(--text-xlo);
    flex: none;
    transition: all var(--t-fast) var(--ease);
  }
  .legend-btn .sw.dash {
    background: none;
    border-top: 1px dashed var(--text-xlo);
  }
  .legend-btn .sw.cy {
    background: var(--cyan);
    opacity: 0.8;
  }
  .legend-btn.active .sw {
    background: var(--cyan) !important;
    box-shadow: 0 0 8px var(--cyan);
  }
  .legend-btn.active .sw.dash {
    border-color: var(--cyan) !important;
    box-shadow: 0 0 8px var(--cyan);
  }

  .plate-stage {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(10px, 2vw, 26px) 0 clamp(40px, 7vw, 80px);
    perspective: 1400px;
  }
  .plate {
    width: min(94vw, 860px);
    aspect-ratio: 1;
    position: relative;
    transform: rotateX(var(--tiltY, 0deg)) rotateY(var(--tiltX, 0deg));
    transition: transform 120ms ease-out;
    will-change: transform;
  }
  .plate svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  .plate-core {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .plate-core svg {
    position: static;
    width: clamp(58px, 7.6vw, 92px);
    height: auto;
    --orca-body: var(--cyan);
    --orca-mark: #050a14;
    opacity: 0.92;
  }

  .etch {
    fill: none;
    stroke: var(--text-xlo);
    stroke-width: 0.7;
    transition: all var(--t-base) var(--ease);
  }
  .etch-hi {
    fill: none;
    stroke: var(--text-lo);
    stroke-width: 0.8;
  }
  .etch-cy {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 0.9;
    opacity: 0.62;
    transition: all var(--t-base) var(--ease);
  }
  .lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    fill: var(--text-lo);
    text-transform: uppercase;
    transition: all var(--t-base) var(--ease);
  }
  .lbl-cy {
    fill: var(--cyan);
    opacity: 0.85;
  }
  .lbl-xs {
    font-family: 'JetBrains Mono', monospace;
    font-size: 7.5px;
    letter-spacing: 0.24em;
    fill: var(--text-xlo);
  }

  /* Filter highlight states for shells */
  .plate.filter-active circle[data-shell],
  .plate.filter-active ellipse,
  .plate.filter-active #fan line,
  .plate.filter-active #fan text,
  .plate.filter-active .turn-r circle {
    opacity: 0.12;
    transition: opacity var(--t-base) var(--ease), stroke var(--t-base) var(--ease), fill var(--t-base) var(--ease);
  }
  .plate.filter-active.filter-LEO .shell-leo,
  .plate.filter-active.filter-LEO .turn-r circle[data-shell="LEO"],
  .plate.filter-active.filter-LEO .lbl-leo {
    opacity: 1 !important;
    stroke: var(--cyan) !important;
    fill: var(--cyan);
    filter: drop-shadow(0 0 6px rgba(0, 229, 255, 0.7));
  }
  .plate.filter-active.filter-MEO .shell-meo,
  .plate.filter-active.filter-MEO .turn-r circle[data-shell="MEO"],
  .plate.filter-active.filter-MEO .lbl-meo {
    opacity: 1 !important;
    stroke: var(--cyan) !important;
    fill: var(--cyan);
    filter: drop-shadow(0 0 6px rgba(0, 229, 255, 0.7));
  }
  .plate.filter-active.filter-GEO .shell-geo,
  .plate.filter-active.filter-GEO .turn-r circle[data-shell="GEO"],
  .plate.filter-active.filter-GEO .lbl-geo {
    opacity: 1 !important;
    stroke: var(--cyan) !important;
    fill: var(--cyan);
    filter: drop-shadow(0 0 6px rgba(0, 229, 255, 0.7));
  }
  .plate.filter-active.filter-FAN #fan line,
  .plate.filter-active.filter-FAN #fan text {
    opacity: 1 !important;
    stroke: var(--cyan) !important;
    fill: var(--cyan) !important;
    filter: drop-shadow(0 0 5px rgba(0, 229, 255, 0.6));
  }

  .turn {
    transform-origin: 500px 500px;
    animation: plateSpin 240s linear infinite;
  }
  .turn-r {
    transform-origin: 500px 500px;
    animation: plateSpin 320s linear infinite reverse;
  }
  @keyframes plateSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Footer */
  .foot {
    position: relative;
    width: 100%;
    padding-top: clamp(40px, 6vw, 72px);
    margin-top: clamp(40px, 6vw, 70px);
    overflow: hidden;
  }
  .foot-rows {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: clamp(24px, 4vw, 48px);
    padding-bottom: clamp(48px, 7vw, 88px);
    border-top: 1px solid var(--line);
    padding-top: 34px;
  }
  .foot-col h4 {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-lo);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 400;
    margin: 0 0 16px;
  }
  .foot-col a {
    display: block;
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
    line-height: 2;
    width: fit-content;
    position: relative;
    transition: color var(--t-fast) var(--ease);
  }
  .foot-col a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-base) var(--ease);
  }
  .foot-col a:hover {
    color: var(--text-hi);
  }
  .foot-col a:hover::after {
    transform: scaleX(1);
  }
  .email-link {
    font-size: clamp(1.15rem, 2.4vw, 1.9rem) !important;
    color: var(--text-hi) !important;
    font-weight: 200 !important;
    letter-spacing: -0.02em !important;
    word-break: break-all;
    position: relative;
  }
  .copy-badge {
    position: absolute;
    right: -70px;
    top: 50%;
    transform: translateY(-50%) scale(0.8);
    background: var(--cyan);
    color: var(--void);
    font-size: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    transition: all 180ms ease;
  }
  .copy-badge.show {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }
  .foot-desc {
    margin: 12px 0 0;
    font-size: 13.5px;
    color: var(--text-lo);
    line-height: 1.6;
  }
  .colophon-text {
    font-size: 13px;
    color: var(--text-lo);
    line-height: 1.75;
  }

  /* Interactive Dot Matrix Canvas Stage */
  .foot-big {
    position: relative;
    width: 100%;
    overflow: hidden;
    line-height: 0;
  }
  .foot-matrix-stage {
    position: relative;
    width: 100%;
    height: clamp(90px, 15.2vw, 220px);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: transparent;
  }
  .foot-matrix-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: default;
    pointer-events: auto;
  }

  .foot-base {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    padding: 0 var(--gutter) 28px;
    margin-top: -3.2vw;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-lo);
    pointer-events: none;
  }
  .foot-base span {
    pointer-events: auto;
  }

  @media (max-width: 840px) {
    .foot-rows {
      grid-template-columns: 1fr 1fr;
    }
    .foot-base {
      margin-top: -4vw;
      padding-bottom: 24px;
    }
  }
  @media (max-width: 520px) {
    .foot-rows {
      grid-template-columns: 1fr;
    }
    .foot-base {
      margin-top: -5vw;
      padding-bottom: 20px;
      font-size: 10px;
    }
  }
</style>

<script>
  function initPlate() {
    const C = 500;
    const NS = 'http://www.w3.org/2000/svg';
    const mk = (t: string, a: Record<string, string | number>) => {
      const e = document.createElementNS(NS, t);
      for (const k in a) e.setAttribute(k, String(a[k]));
      return e;
    };
    const pt = (r: number, degFromUp: number): [number, number] => {
      const t = ((degFromUp - 90) * Math.PI) / 180;
      return [C + r * Math.cos(t), C + r * Math.sin(t)];
    };

    // Rim ticks
    const ticks = document.getElementById('rimTicks');
    if (ticks && ticks.children.length === 0) {
      for (let d = 0; d < 360; d += 3) {
        const major = d % 15 === 0;
        const cardinal = d % 90 === 0;
        const r1 = 452;
        const r2 = cardinal ? 476 : major ? 468 : 461;
        const [x1, y1] = pt(r1, d);
        const [x2, y2] = pt(r2, d);
        ticks.appendChild(
          mk('line', {
            x1,
            y1,
            x2,
            y2,
            stroke: cardinal ? 'var(--cyan)' : 'var(--text-xlo)',
            'stroke-width': cardinal ? 1.1 : major ? 0.8 : 0.55,
            opacity: cardinal ? 0.7 : major ? 0.9 : 0.5,
          }),
        );
      }
    }

    // Inclination fan
    const fan = document.getElementById('fan');
    if (fan && fan.children.length === 0) {
      const INC = [
        { i: 0, t: '0.0 EQUATORIAL' },
        { i: 28.5, t: '28.5 CAPE' },
        { i: 51.6, t: '51.6 ISS' },
        { i: 63.4, t: '63.4 MOLNIYA' },
        { i: 86.4, t: '86.4 POLAR' },
        { i: 97.8, t: '97.8 SUN-SYNC' },
      ];
      INC.forEach(({ i, t }) => {
        const live = i === 51.6;
        const rays = i === 0 ? [90, 270] : [90 - i, 90 + i, 270 - i, 270 + i];
        rays.forEach((d) => {
          const [x1, y1] = pt(122, d);
          const [x2, y2] = pt(388, d);
          fan.appendChild(
            mk('line', {
              x1,
              y1,
              x2,
              y2,
              stroke: live ? 'var(--cyan)' : 'var(--text-xlo)',
              'stroke-width': live ? 0.9 : 0.6,
              opacity: live ? 0.8 : 0.4,
            }),
          );
        });
        const d = 90 - i;
        const [lx, ly] = pt(406, d);
        const flip = (d + 360) % 360 > 180;
        const lab = mk('text', {
          x: lx,
          y: ly,
          class: 'lbl-xs' + (live ? ' lbl-cy' : ''),
          'text-anchor': flip ? 'end' : 'start',
          'dominant-baseline': 'middle',
          transform: 'rotate(' + (flip ? d + 90 : d - 90) + ' ' + lx + ' ' + ly + ')',
        });
        lab.textContent = t;
        fan.appendChild(lab);
      });
    }

    // Catalogue marks
    const cat = document.getElementById('cat');
    if (cat && cat.children.length === 0) {
      let s = 4589;
      const rnd = () => (s = (s * 1103515245 + 12345) % 2147483648) / 2147483648;
      const FEATURED = 6;
      for (let n = 0; n < 168; n++) {
        const roll = rnd();
        const shell = roll < 0.68 ? 'LEO' : roll < 0.86 ? 'MEO' : 'GEO';
        const r = shell === 'LEO' ? 190 + rnd() * 22 : shell === 'MEO' ? 282 + rnd() * 14 : 368 + rnd() * 9;
        const [x, y] = pt(r, rnd() * 360);
        const feat = n < FEATURED;
        cat.appendChild(
          mk('circle', {
            cx: x,
            cy: y,
            r: feat ? 2.6 : shell === 'LEO' ? 1.5 : 1.9,
            fill: feat ? 'var(--cyan)' : 'var(--text-lo)',
            opacity: feat ? 0.95 : 0.38 + rnd() * 0.34,
            'data-shell': shell,
          }),
        );
        if (feat) {
          cat.appendChild(
            mk('circle', {
              cx: x,
              cy: y,
              r: 6.5,
              fill: 'none',
              stroke: 'var(--cyan)',
              'stroke-width': 0.6,
              opacity: 0.4,
              'data-shell': shell,
            }),
          );
        }
      }
    }

    // Shell filter buttons in Legend
    const legendBtns = document.querySelectorAll<HTMLButtonElement>('.legend-btn');
    const plateEl = document.getElementById('mainPlate');

    legendBtns.forEach((btn) => {
      btn.onclick = () => {
        const shell = btn.dataset.shell;
        const isActive = btn.classList.contains('active');

        legendBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });

        if (plateEl) {
          plateEl.classList.remove('filter-active', 'filter-LEO', 'filter-MEO', 'filter-GEO', 'filter-FAN');
        }

        if (!isActive && shell && plateEl) {
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          plateEl.classList.add('filter-active', `filter-${shell}`);
        }
      };
    });

    // Email click & copy helper
    const emailLink = document.getElementById('footerEmailLink');
    const copyBadge = document.getElementById('emailCopyBadge');
    if (emailLink) {
      emailLink.onclick = () => {
        const email = 'fenilmmodi@gmail.com';
        if (navigator.clipboard) {
          navigator.clipboard.writeText(email).then(() => {
            if (copyBadge) {
              copyBadge.classList.add('show');
              setTimeout(() => copyBadge.classList.remove('show'), 2000);
            }
          }).catch(() => {});
        }
      };
    }

    // Live UTC epoch in footer
    const epochFoot = document.getElementById('epochFoot');
    const yr = document.getElementById('yr');
    function updateEpoch() {
      const d = new Date();
      const p = (n: number) => String(n).padStart(2, '0');
      if (yr) yr.textContent = String(d.getUTCFullYear());
      if (epochFoot) {
        epochFoot.textContent = `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())}`;
      }
    }
    updateEpoch();

    // 3D Interactive Tilt on the Keplerian Plate
    const stages = document.querySelectorAll<HTMLElement>('.plate-stage');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) {
      stages.forEach((stage) => {
        const plate = stage.querySelector<HTMLElement>('.plate');
        if (!plate) return;
        let raf = 0;
        let curX = 0;
        let curY = 0;
        const TILT_DEG = 8;

        stage.onpointermove = (e) => {
          const rect = stage.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width;
          const py = (e.clientY - rect.top) / rect.height;
          curX = (px - 0.5) * TILT_DEG * 2;
          curY = (0.5 - py) * TILT_DEG * 2;
          if (!raf) {
            raf = requestAnimationFrame(() => {
              plate.style.setProperty('--tiltX', `${curX.toFixed(2)}deg`);
              plate.style.setProperty('--tiltY', `${curY.toFixed(2)}deg`);
              raf = 0;
            });
          }
        };

        stage.onpointerleave = () => {
          plate.style.setProperty('--tiltX', '0deg');
          plate.style.setProperty('--tiltY', '0deg');
        };
      });
    }

    // ══════════════════════════════════════════════════════════════════════
    // DOT MATRIX ORCAS FOOTER INTERACTION (Magnetic Repel + Scroll Reveal)
    // ══════════════════════════════════════════════════════════════════════
    initDotMatrix();
  }

  function initDotMatrix() {
    const stage = document.getElementById('footMatrixStage') as HTMLElement;
    const canvas = document.getElementById('footMatrixCanvas') as HTMLCanvasElement;
    if (!stage || !canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const PATH_STRINGS = [
      // O
      'M43.9 1.2Q35.6 1.2 28.6 -1.7Q21.5 -4.6 16.2 -9.8Q10.9 -15 7.9 -22Q5 -29.1 5 -37.3Q5 -45.6 7.9 -52.6Q10.8 -59.6 16.1 -64.8Q21.4 -70 28.5 -72.8Q35.6 -75.7 43.9 -75.7Q52.2 -75.7 59.3 -72.8Q66.4 -69.9 71.7 -64.7Q77 -59.6 79.9 -52.6Q82.9 -45.6 82.9 -37.3Q82.9 -29.1 79.9 -22Q76.9 -15 71.6 -9.8Q66.3 -4.6 59.2 -1.7Q52.2 1.2 43.9 1.2ZM43.9 -11.2Q49.4 -11.2 54 -13.1Q58.6 -15.1 62 -18.6Q65.5 -22.1 67.3 -26.9Q69.2 -31.7 69.2 -37.3Q69.2 -42.9 67.3 -47.7Q65.5 -52.4 62 -56Q58.6 -59.5 54 -61.4Q49.4 -63.3 43.9 -63.3Q38.5 -63.3 33.9 -61.4Q29.2 -59.5 25.8 -56Q22.4 -52.4 20.5 -47.7Q18.6 -42.9 18.6 -37.3Q18.6 -31.7 20.5 -26.9Q22.4 -22.1 25.8 -18.6Q29.2 -15.1 33.9 -13.1Q38.5 -11.2 43.9 -11.2Z',
      // R
      'M103 0V-74.5H130.7Q138.3 -74.5 144.2 -71.8Q150 -69 153.3 -63.8Q156.6 -58.5 156.6 -51Q156.6 -43.3 153 -37.9Q149.3 -32.5 143.1 -29.9L160.2 0H144.8L126.5 -32.7L135.3 -27.5H116.6V0ZM116.6 -39.5H130.9Q134.6 -39.5 137.3 -40.9Q140 -42.4 141.5 -45Q143 -47.6 143 -51Q143 -54.5 141.5 -57Q140 -59.6 137.3 -61.1Q134.6 -62.5 130.9 -62.5H116.6Z',
      // C
      'M212.1 1.2Q204.1 1.2 197.3 -1.7Q190.6 -4.6 185.5 -9.8Q180.5 -15 177.7 -22Q174.8 -29 174.8 -37.3Q174.8 -45.6 177.6 -52.6Q180.4 -59.7 185.4 -64.8Q190.5 -70 197.3 -72.8Q204.1 -75.7 212.1 -75.7Q220.1 -75.7 226.4 -73Q232.8 -70.3 237.2 -65.9Q241.6 -61.4 243.5 -56.1L231.3 -50.4Q229.2 -56 224.2 -59.7Q219.2 -63.3 212.1 -63.3Q205.1 -63.3 199.8 -60Q194.4 -56.7 191.4 -50.9Q188.5 -45.1 188.5 -37.3Q188.5 -29.5 191.4 -23.6Q194.4 -17.8 199.8 -14.5Q205.1 -11.2 212.1 -11.2Q219.2 -11.2 224.2 -14.8Q229.2 -18.4 231.3 -24.1L243.5 -18.4Q241.6 -13.1 237.2 -8.6Q232.8 -4.2 226.4 -1.5Q220.1 1.2 212.1 1.2Z',
      // A
      'M256.4 0 282.1 -74.5H299.7L325.4 0H310.6L305.3 -16H276.5L271.1 0ZM280.4 -28H301.4L289 -65H292.8Z',
      // S
      'M368.2 1.2Q361.2 1.2 355.2 -1.4Q349.1 -4 344.8 -8.6Q340.4 -13.3 338.4 -19.5L349.7 -24.4Q352.4 -17.9 357.5 -14.3Q362.6 -10.7 369 -10.7Q372.6 -10.7 375.2 -11.9Q377.9 -13 379.4 -15Q380.8 -17 380.8 -19.8Q380.8 -23.1 378.9 -25.2Q376.9 -27.4 373 -28.6L358.7 -33.2Q350 -35.9 345.6 -41.3Q341.1 -46.7 341.1 -54Q341.1 -60.4 344.3 -65.3Q347.5 -70.2 353.1 -73Q358.8 -75.7 366.1 -75.7Q372.8 -75.7 378.4 -73.4Q384 -71 388 -66.9Q392.1 -62.7 394.1 -57.1L382.9 -52.1Q380.7 -57.7 376.3 -60.7Q371.9 -63.8 366.1 -63.8Q362.7 -63.8 360.1 -62.7Q357.5 -61.5 356.1 -59.4Q354.6 -57.4 354.6 -54.6Q354.6 -51.5 356.6 -49.1Q358.6 -46.8 362.7 -45.5L376.4 -41.2Q385.3 -38.3 389.8 -33.2Q394.2 -28.1 394.2 -20.6Q394.2 -14.2 390.9 -9.3Q387.6 -4.4 381.8 -1.6Q375.9 1.2 368.2 1.2Z',
    ];

    const combinedPath = new Path2D(PATH_STRINGS.join(' '));

    const VB_W = 408;
    const VB_H = 62;
    const Y_MIN = -78;
    const GRID_STEP = 1.4;

    const samplePoints: { u: number; v: number }[] = [];
    const offCanvas = document.createElement('canvas');
    const offCtx = offCanvas.getContext('2d');

    if (offCtx) {
      for (let gy = -76; gy <= 2; gy += GRID_STEP) {
        for (let gx = 0; gx <= 408; gx += GRID_STEP) {
          if (offCtx.isPointInPath(combinedPath, gx, gy)) {
            samplePoints.push({
              u: gx / VB_W,
              v: (gy - Y_MIN) / VB_H,
            });
          }
        }
      }
    }

    interface DotParticle {
      u: number;
      v: number;
      ox: number;
      oy: number;
      x: number;
      y: number;
      vx: number;
      vy: number;
      scatterX: number;
      scatterY: number;
      baseR: number;
    }

    let particles: DotParticle[] = [];
    let W = 0;
    let H = 0;
    let DPR = 1;
    const mouse = { x: -9999, y: -9999, active: false };
    let isRevealed = false;
    let revealProgress = 0;
    let isRunning = false;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function resize() {
      const rect = stage.getBoundingClientRect();
      if (!rect.width || !rect.height) return;

      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width;
      H = rect.height;
      canvas.width = Math.round(W * DPR);
      canvas.height = Math.round(H * DPR);
      ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);

      const scale = W / VB_W;
      const dotRadius = Math.max(0.55, Math.min(1.25, scale * 0.28));

      particles = samplePoints.map((pt) => {
        const ox = pt.u * W;
        const oy = pt.v * (VB_H * scale);

        const angle = Math.random() * Math.PI * 2;
        const dist = 24 + Math.random() * 64;
        const scatterX = Math.cos(angle) * dist;
        const scatterY = Math.sin(angle) * dist;

        return {
          u: pt.u,
          v: pt.v,
          ox,
          oy,
          x: isRevealed || reduceMotion ? ox : ox + scatterX,
          y: isRevealed || reduceMotion ? oy : oy + scatterY,
          vx: 0,
          vy: 0,
          scatterX,
          scatterY,
          baseR: dotRadius,
        };
      });

      if (!isRunning) {
        isRunning = true;
        requestAnimationFrame(render);
      }
    }

    function onPointerMove(e: PointerEvent) {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.active = true;

      if (!isRunning) {
        isRunning = true;
        requestAnimationFrame(render);
      }
    }

    function onPointerLeave() {
      mouse.active = false;
    }

    stage.onpointermove = onPointerMove;
    stage.onpointerleave = onPointerLeave;

    if ('IntersectionObserver' in window && !reduceMotion) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && !isRevealed) {
              isRevealed = true;
              if (!isRunning) {
                isRunning = true;
                requestAnimationFrame(render);
              }
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.05 },
      );
      observer.observe(stage);
    } else {
      isRevealed = true;
    }

    function easeOutCubic(x: number): number {
      return 1 - Math.pow(1 - x, 3);
    }

    function render() {
      if (!ctx) return;

      if (isRevealed && revealProgress < 1 && !reduceMotion) {
        revealProgress = Math.min(1, revealProgress + 0.022);
      } else if (reduceMotion) {
        revealProgress = 1;
      }

      const revealEase = easeOutCubic(revealProgress);
      const repelRadius = Math.max(65, Math.min(125, W * 0.10));
      const repelStrength = 1.15;
      const springK = 0.12;
      const damping = 0.73;

      ctx.clearRect(0, 0, W, H);

      let maxVelocity = 0;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        const tx = p.ox + p.scatterX * (1 - revealEase);
        const ty = p.oy + p.scatterY * (1 - revealEase);

        if (mouse.active) {
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const dist = Math.hypot(dx, dy);

          if (dist < repelRadius && dist > 0.1) {
            const force = Math.pow(1 - dist / repelRadius, 1.8) * repelStrength;
            p.vx += (dx / dist) * force * 1.25;
            p.vy += (dy / dist) * force * 1.25;
          }
        }

        // Controlled ease-out return with zero overshoot/wobble
        p.vx += (tx - p.x) * springK;
        p.vy += (ty - p.y) * springK;
        p.vx *= damping;
        p.vy *= damping;

        p.x += p.vx;
        p.y += p.vy;

        const speed = Math.hypot(p.vx, p.vy);
        if (speed > maxVelocity) maxVelocity = speed;

        const disp = Math.hypot(p.x - p.ox, p.y - p.oy);
        const isDisplaced = disp > 1.8;

        let r = p.baseR;
        let fillStyle = '';

        if (isDisplaced) {
          const t = Math.min(1, (disp - 1.8) / 24);
          r = p.baseR * (1 + t * 0.35);
          const alpha = Math.min(0.92, 0.24 + t * 0.68);
          fillStyle = `rgba(0, 229, 255, ${alpha.toFixed(2)})`;
        } else {
          const alpha = 0.15 + revealEase * 0.08;
          fillStyle = `rgba(232, 237, 247, ${alpha.toFixed(2)})`;
        }

        ctx.beginPath();
        ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
        ctx.fillStyle = fillStyle;
        ctx.fill();
      }

      if (mouse.active || maxVelocity > 0.03 || revealProgress < 1) {
        requestAnimationFrame(render);
      } else {
        isRunning = false;
      }
    }

    window.removeEventListener('resize', resize);
    window.addEventListener('resize', resize, { passive: true });
    resize();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPlate);
  } else {
    initPlate();
  }
  document.addEventListener('astro:page-load', initPlate);
</script>
