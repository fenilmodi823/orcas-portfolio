---
import { LINKS } from '@/data/links';
---

<section class="plate-sec" id="contact" data-sec="Contact">
  <div class="wrap">
    <div class="plate-intro">
      <div>
        <div class="eyebrow"><span class="mono">Plate 01</span></div>
        <h2 class="h2">A record of where everything was.</h2>
      </div>
      <div class="plate-legend mono" id="plateLegend">
        <div><span class="sw cy"></span>Low Earth orbit · 550 km</div>
        <div><span class="sw dash"></span>Medium Earth orbit · 20 200 km</div>
        <div><span class="sw dash"></span>Geostationary · 35 786 km</div>
        <div><span class="sw"></span>Inclination fan · degrees</div>
      </div>
    </div>
  </div>

  <div class="plate-stage">
    <div class="plate">
      <svg viewBox="0 0 1000 1000" role="img" aria-label="The ORCAS Plate — orbital shells, inclination fan and catalogue marks">
        <defs>
          <path id="ringTextA" fill="none" d="M500 68 a432 432 0 1 1 -.1 0"></path>
          <!-- counter-clockwise so the lower band reads right-way-up -->
          <path id="ringTextB" fill="none" d="M500 906 a406 406 0 1 0 -.1 0"></path>
          <radialGradient id="coreG" cx="40%" cy="34%">
            <stop offset="0" style="stop-color: #0d2847"></stop>
            <stop offset=".6" style="stop-color: #071324"></stop>
            <stop offset="1" style="stop-color: var(--void)"></stop>
          </radialGradient>
        </defs>

        <!-- rim + tick band, turning -->
        <g class="turn">
          <circle class="etch-hi" cx="500" cy="500" r="468"></circle>
          <circle class="etch" cx="500" cy="500" r="452"></circle>
          <g id="rimTicks"></g>
        </g>

        <!-- annotation band -->
        <text class="lbl-xs">
          <textPath href="#ringTextA" startOffset="0">
            ORCAS · ORBITAL RISK AND CONJUNCTION ASSESSMENT SYSTEM · EVERY OBJECT ABOVE EARTH, PROPAGATED · SGP4 / SDP4 · PLATE 01 OF 01 ·
          </textPath>
        </text>
        <text class="lbl-xs">
          <textPath href="#ringTextB" startOffset="0">
            THE CATALOGUE IS PUBLIC · THE SKY IS NOT LEGIBLE WITHOUT IT · BUILT BY FENIL MODI · MMXXVI ·
          </textPath>
        </text>

        <!-- shells -->
        <circle class="etch" cx="500" cy="500" r="372" stroke-dasharray="5 9"></circle>
        <circle class="etch" cx="500" cy="500" r="288" stroke-dasharray="5 9"></circle>
        <circle class="etch-cy" cx="500" cy="500" r="198"></circle>

        <!-- inclination fan -->
        <g id="fan"></g>

        <!-- two eccentric paths across the shells -->
        <ellipse class="etch" cx="500" cy="428" rx="180" ry="330" transform="rotate(-24 500 500)" opacity=".7"></ellipse>
        <ellipse class="etch" cx="500" cy="556" rx="330" ry="126" transform="rotate(16 500 500)" opacity=".55"></ellipse>

        <!-- catalogue marks, counter-turning -->
        <g class="turn-r" id="cat"></g>

        <!-- Earth -->
        <circle cx="500" cy="500" r="108" fill="url(#coreG)"></circle>
        <circle class="etch-cy" cx="500" cy="500" r="108" opacity=".45"></circle>
        <g class="etch" opacity=".45">
          <ellipse cx="500" cy="500" rx="108" ry="38"></ellipse>
          <ellipse cx="500" cy="500" rx="108" ry="76"></ellipse>
          <ellipse cx="500" cy="500" rx="42" ry="108"></ellipse>
          <ellipse cx="500" cy="500" rx="80" ry="108"></ellipse>
        </g>

        <!-- rim annotations, fixed -->
        <text class="lbl" x="500" y="26" text-anchor="middle">00h</text>
        <text class="lbl" x="988" y="504" text-anchor="end">06h</text>
        <text class="lbl" x="500" y="988" text-anchor="middle">12h</text>
        <text class="lbl" x="12" y="504">18h</text>

        <text class="lbl lbl-cy" x="500" y="292" text-anchor="middle">LEO</text>
        <text class="lbl" x="500" y="202" text-anchor="middle">MEO</text>
        <text class="lbl" x="500" y="118" text-anchor="middle">GEO</text>
      </svg>
      <div class="plate-core">
        <svg viewBox="62 45 88 120"><use href="#g-orca"></use></svg>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="foot">
    <div class="wrap">
      <div class="foot-rows">
        <div class="foot-col transmit-col">
          <h4>Transmit</h4>
          <a href={LINKS.email} class="email-link">{LINKS.email.replace('mailto:', '')}</a>
          <p class="foot-desc">
            Open to collaboration on orbital tooling, 3D interfaces, and anything that makes public space data usable.
          </p>
        </div>
        <div class="foot-col">
          <h4>Elsewhere</h4>
          <a href={LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={LINKS.x} target="_blank" rel="noopener noreferrer">X / Twitter</a>
          <a href={LINKS.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
        <div class="foot-col">
          <h4>Routes</h4>
          <a href="/">Home</a>
          <a href="/research">Research</a>
          <a href="/projects">Projects</a>
          <a href="/cv">CV & Résumé</a>
        </div>
        <div class="foot-col">
          <h4>Colophon</h4>
          <span class="mono colophon-text">
            Plus Jakarta Sans<br />
            JetBrains Mono<br />
            Built with Astro 7
          </span>
        </div>
      </div>
    </div>

    <!-- Giant edge-to-edge ORCAS wordmark touching the bottom -->
    <div class="foot-big">
      <svg viewBox="0 -80 408 62" preserveAspectRatio="xMidYMax meet"><use href="#g-word"></use></svg>
    </div>

    <!-- Metadata line overlaid directly on the bottom part of the ORCAS wordmark -->
    <div class="wrap foot-base mono">
      <span>© <span id="yr">2026</span> Fenil Modi</span>
      <span>Plate 01 · <span id="epochFoot">2026-08-21</span> UTC</span>
    </div>
  </footer>
</section>

<style>
  .plate-sec {
    position: relative;
    width: 100%;
    padding-top: clamp(24px, 4vh, 56px);
    padding-bottom: 0;
    overflow: hidden;
  }
  .plate-intro {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
    margin-bottom: clamp(30px, 5vw, 58px);
  }
  .plate-intro .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .plate-intro .eyebrow::before {
    content: '';
    width: 22px;
    height: 1px;
    background: var(--cyan);
    opacity: 0.55;
  }
  .plate-intro h2 {
    font-size: clamp(1.9rem, 3.4vw, 3.1rem);
    font-weight: 200;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text-hi);
    margin: 0;
    max-width: 16ch;
  }

  .plate-legend {
    display: grid;
    gap: 11px;
    min-width: 236px;
  }
  .plate-legend div {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-lo);
  }
  .plate-legend .sw {
    width: 16px;
    height: 1px;
    background: var(--text-xlo);
    flex: none;
  }
  .plate-legend .sw.dash {
    background: none;
    border-top: 1px dashed var(--text-xlo);
  }
  .plate-legend .sw.cy {
    background: var(--cyan);
    opacity: 0.8;
  }

  .plate-stage {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(10px, 2vw, 26px) 0 clamp(40px, 7vw, 80px);
    perspective: 1400px;
  }
  .plate {
    width: min(94vw, 860px);
    aspect-ratio: 1;
    position: relative;
    transform: rotateX(var(--tiltY, 0deg)) rotateY(var(--tiltX, 0deg));
    transition: transform 120ms ease-out;
    will-change: transform;
  }
  .plate svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  .plate-core {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .plate-core svg {
    position: static;
    width: clamp(58px, 7.6vw, 92px);
    height: auto;
    --orca-body: var(--cyan);
    --orca-mark: #050a14;
    opacity: 0.92;
  }

  .etch {
    fill: none;
    stroke: var(--text-xlo);
    stroke-width: 0.7;
  }
  .etch-hi {
    fill: none;
    stroke: var(--text-lo);
    stroke-width: 0.8;
  }
  .etch-cy {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 0.9;
    opacity: 0.62;
  }
  .lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    fill: var(--text-lo);
    text-transform: uppercase;
  }
  .lbl-cy {
    fill: var(--cyan);
    opacity: 0.85;
  }
  .lbl-xs {
    font-family: 'JetBrains Mono', monospace;
    font-size: 7.5px;
    letter-spacing: 0.24em;
    fill: var(--text-xlo);
  }

  .turn {
    transform-origin: 500px 500px;
    animation: plateSpin 240s linear infinite;
  }
  .turn-r {
    transform-origin: 500px 500px;
    animation: plateSpin 320s linear infinite reverse;
  }
  @keyframes plateSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Footer */
  .foot {
    position: relative;
    width: 100%;
    padding-top: clamp(40px, 6vw, 72px);
    margin-top: clamp(40px, 6vw, 70px);
    overflow: hidden;
  }
  .foot-rows {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: clamp(24px, 4vw, 48px);
    padding-bottom: clamp(48px, 7vw, 88px);
    border-top: 1px solid var(--line);
    padding-top: 34px;
  }
  .foot-col h4 {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-lo);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 400;
    margin: 0 0 16px;
  }
  .foot-col a {
    display: block;
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
    line-height: 2;
    width: fit-content;
    position: relative;
    transition: color var(--t-fast) var(--ease);
  }
  .foot-col a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-base) var(--ease);
  }
  .foot-col a:hover {
    color: var(--text-hi);
  }
  .foot-col a:hover::after {
    transform: scaleX(1);
  }
  .email-link {
    font-size: clamp(1.15rem, 2.4vw, 1.9rem) !important;
    color: var(--text-hi) !important;
    font-weight: 200 !important;
    letter-spacing: -0.02em !important;
    word-break: break-all;
  }
  .foot-desc {
    margin: 12px 0 0;
    font-size: 13.5px;
    color: var(--text-lo);
    line-height: 1.6;
  }
  .colophon-text {
    font-size: 13px;
    color: var(--text-lo);
    line-height: 1.75;
  }

  .foot-big {
    position: relative;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    pointer-events: none;
  }
  .foot-big svg {
    width: 100%;
    height: auto;
    color: var(--text-hi);
    opacity: 0.055;
    display: block;
    transform: translateY(19%);
    pointer-events: none;
  }
  @media (max-width: 720px) {
    .foot-big svg {
      transform: translateY(24%);
    }
  }

  .foot-base {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    padding: 0 var(--gutter) 28px;
    margin-top: -3.2vw;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-lo);
  }

  @media (max-width: 840px) {
    .foot-rows {
      grid-template-columns: 1fr 1fr;
    }
    .foot-base {
      margin-top: -4vw;
      padding-bottom: 24px;
    }
  }
  @media (max-width: 520px) {
    .foot-rows {
      grid-template-columns: 1fr;
    }
    .foot-base {
      margin-top: -5vw;
      padding-bottom: 20px;
      font-size: 10px;
    }
  }
</style>

<script>
  // SVG Generator for Plate
  const C = 500;
  const NS = 'http://www.w3.org/2000/svg';
  const mk = (t: string, a: Record<string, string | number>) => {
    const e = document.createElementNS(NS, t);
    for (const k in a) e.setAttribute(k, String(a[k]));
    return e;
  };
  const pt = (r: number, degFromUp: number): [number, number] => {
    const t = ((degFromUp - 90) * Math.PI) / 180;
    return [C + r * Math.cos(t), C + r * Math.sin(t)];
  };

  // Rim ticks
  const ticks = document.getElementById('rimTicks');
  if (ticks && ticks.children.length === 0) {
    for (let d = 0; d < 360; d += 3) {
      const major = d % 15 === 0;
      const cardinal = d % 90 === 0;
      const r1 = 452;
      const r2 = cardinal ? 476 : major ? 468 : 461;
      const [x1, y1] = pt(r1, d);
      const [x2, y2] = pt(r2, d);
      ticks.appendChild(
        mk('line', {
          x1,
          y1,
          x2,
          y2,
          stroke: cardinal ? 'var(--cyan)' : 'var(--text-xlo)',
          'stroke-width': cardinal ? 1.1 : major ? 0.8 : 0.55,
          opacity: cardinal ? 0.7 : major ? 0.9 : 0.5,
        }),
      );
    }
  }

  // Inclination fan
  const fan = document.getElementById('fan');
  if (fan && fan.children.length === 0) {
    const INC = [
      { i: 0, t: '0.0 EQUATORIAL' },
      { i: 28.5, t: '28.5 CAPE' },
      { i: 51.6, t: '51.6 ISS' },
      { i: 63.4, t: '63.4 MOLNIYA' },
      { i: 86.4, t: '86.4 POLAR' },
      { i: 97.8, t: '97.8 SUN-SYNC' },
    ];
    INC.forEach(({ i, t }) => {
      const live = i === 51.6;
      const rays = i === 0 ? [90, 270] : [90 - i, 90 + i, 270 - i, 270 + i];
      rays.forEach((d) => {
        const [x1, y1] = pt(122, d);
        const [x2, y2] = pt(388, d);
        fan.appendChild(
          mk('line', {
            x1,
            y1,
            x2,
            y2,
            stroke: live ? 'var(--cyan)' : 'var(--text-xlo)',
            'stroke-width': live ? 0.9 : 0.6,
            opacity: live ? 0.8 : 0.4,
          }),
        );
      });
      const d = 90 - i;
      const [lx, ly] = pt(406, d);
      const flip = (d + 360) % 360 > 180;
      const lab = mk('text', {
        x: lx,
        y: ly,
        class: 'lbl-xs' + (live ? ' lbl-cy' : ''),
        'text-anchor': flip ? 'end' : 'start',
        'dominant-baseline': 'middle',
        transform: 'rotate(' + (flip ? d + 90 : d - 90) + ' ' + lx + ' ' + ly + ')',
      });
      lab.textContent = t;
      fan.appendChild(lab);
    });
  }

  // Catalogue marks
  const cat = document.getElementById('cat');
  if (cat && cat.children.length === 0) {
    let s = 4589;
    const rnd = () => (s = (s * 1103515245 + 12345) % 2147483648) / 2147483648;
    const FEATURED = 6;
    for (let n = 0; n < 168; n++) {
      const roll = rnd();
      const shell = roll < 0.68 ? 'LEO' : roll < 0.86 ? 'MEO' : 'GEO';
      const r = shell === 'LEO' ? 190 + rnd() * 22 : shell === 'MEO' ? 282 + rnd() * 14 : 368 + rnd() * 9;
      const [x, y] = pt(r, rnd() * 360);
      const feat = n < FEATURED;
      cat.appendChild(
        mk('circle', {
          cx: x,
          cy: y,
          r: feat ? 2.6 : shell === 'LEO' ? 1.5 : 1.9,
          fill: feat ? 'var(--cyan)' : 'var(--text-lo)',
          opacity: feat ? 0.95 : 0.38 + rnd() * 0.34,
        }),
      );
      if (feat) {
        cat.appendChild(
          mk('circle', {
            cx: x,
            cy: y,
            r: 6.5,
            fill: 'none',
            stroke: 'var(--cyan)',
            'stroke-width': 0.6,
            opacity: 0.4,
          }),
        );
      }
    }
  }

  // Live UTC epoch in footer
  const epochFoot = document.getElementById('epochFoot');
  const yr = document.getElementById('yr');
  function updateEpoch() {
    const d = new Date();
    const p = (n: number) => String(n).padStart(2, '0');
    if (yr) yr.textContent = String(d.getUTCFullYear());
    if (epochFoot) {
      epochFoot.textContent = `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())}`;
    }
  }
  updateEpoch();
  setInterval(updateEpoch, 1000);

  // 3D Interactive Tilt on the Keplerian Plate
  const stages = document.querySelectorAll<HTMLElement>('.plate-stage');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    stages.forEach((stage) => {
      const plate = stage.querySelector<HTMLElement>('.plate');
      if (!plate) return;
      let raf = 0;
      let curX = 0;
      let curY = 0;
      const TILT_DEG = 8;

      stage.addEventListener('pointermove', (e) => {
        const rect = stage.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width;
        const py = (e.clientY - rect.top) / rect.height;
        curX = (px - 0.5) * TILT_DEG * 2;
        curY = (0.5 - py) * TILT_DEG * 2;
        if (!raf) {
          raf = requestAnimationFrame(() => {
            plate.style.setProperty('--tiltX', `${curX.toFixed(2)}deg`);
            plate.style.setProperty('--tiltY', `${curY.toFixed(2)}deg`);
            raf = 0;
          });
        }
      });

      stage.addEventListener('pointerleave', () => {
        plate.style.setProperty('--tiltX', '0deg');
        plate.style.setProperty('--tiltY', '0deg');
      });
    });
  }
</script>
