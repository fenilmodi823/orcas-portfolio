---
interface Props {
  variant?: 'feature' | 'tall' | 'half';
  title: string;
  description: string;
  href: string;
  tag?: string;
  meta?: string;
  eyebrow?: string;
}

const { variant = 'half', title, description, href, tag, meta, eyebrow } = Astro.props;
---

<a class:list={['card', `card-${variant}`]} href={href}>
  <div class="card-inner">
    {eyebrow && <span class="card-eyebrow mono">{eyebrow}</span>}
    <div class="card-head">
      <h3 class="card-title">{title}</h3>
      {tag && <span class="card-tag mono">{tag}</span>}
    </div>
    <p class="card-desc">{description}</p>
    {meta && <div class="card-meta mono">{meta}</div>}
  </div>
  <slot />
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    color: inherit;
    border-radius: var(--r-panel);
    padding: clamp(20px, 3vw, 32px);
    background: var(--glass-fill);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    border: 1px solid var(--glass-edge);
    transition: border-color var(--t-fast) var(--ease), transform var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
    position: relative;
    overflow: hidden;
  }
  .card:hover {
    border-color: var(--line-hi);
    background: rgba(14, 22, 38, 0.55);
    transform: translateY(-2px);
  }
  .card-feature {
    grid-column: span 12;
  }
  .card-tall {
    grid-column: span 6;
    min-height: 380px;
  }
  .card-half {
    grid-column: span 6;
  }
  .card-eyebrow {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 8px;
    display: block;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
  }
  .card-title {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 300;
    color: var(--text-hi);
    margin: 0;
  }
  .card-tag {
    font-size: 10px;
    color: var(--text-lo);
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: var(--r-chip);
    flex: none;
  }
  .card-desc {
    font-size: 13.5px;
    color: var(--text);
    line-height: 1.65;
    margin: 0 0 16px;
  }
  .card-meta {
    font-size: 11px;
    color: var(--text-lo);
    letter-spacing: 0.08em;
    margin-top: auto;
  }

  @media (max-width: 840px) {
    .card-tall,
    .card-half {
      grid-column: span 12;
      min-height: auto;
    }
  }
</style>
