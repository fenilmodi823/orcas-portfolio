---
import type { SkillGroup } from '@/data/skills';

interface Props {
  group: SkillGroup;
}

const { group } = Astro.props;
---

<div class="skill-col">
  <div class="skill-head">
    <h3 class="skill-group-name">{group.g}</h3>
    <p class="skill-hint">{group.hint}</p>
  </div>
  <ul class="skill-list">
    {group.items.map(([name, level]) => (
      <li class="skill-item">
        <span class="skill-name">{name}</span>
        <span class="skill-bars mono" aria-label={`Proficiency: ${level} out of 5`}>
          {Array.from({ length: 5 }, (_, i) => (
            <i class:list={['bar', { fill: i < level }]} />
          ))}
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  .skill-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    background: var(--glass-fill);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
  }
  .skill-group-name {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-hi);
    margin: 0 0 6px;
  }
  .skill-hint {
    font-size: 12px;
    color: var(--text-lo);
    margin: 0;
    line-height: 1.5;
  }
  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .skill-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--text);
  }
  .skill-name {
    font-size: 13px;
  }
  .skill-bars {
    display: flex;
    gap: 3px;
    align-items: center;
    flex: none;
  }
  .bar {
    width: 6px;
    height: 10px;
    border-radius: 2px;
    background: rgba(232, 237, 247, 0.1);
    display: inline-block;
  }
  .bar.fill {
    background: var(--cyan);
    opacity: 0.85;
  }
</style>
