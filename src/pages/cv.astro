---
import { getEntry, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Background from '@/components/Background.astro';
import Nav from '@/components/Nav.astro';
import Dock from '@/components/Dock.astro';
import Plate from '@/components/Plate.astro';

const resumeDoc = await getEntry('docs', 'resume');
const cvDoc = await getEntry('docs', 'cv');

const { Content: ResumeContent } = resumeDoc ? await render(resumeDoc) : { Content: null };
const { Content: CvContent } = cvDoc ? await render(cvDoc) : { Content: null };

// Check if PDF files exist in public/files
const resumePdfPath = path.resolve('public/files/Fenil-Modi-Resume.pdf');
const cvPdfPath = path.resolve('public/files/Fenil-Modi-CV.pdf');
const hasResumePdf = fs.existsSync(resumePdfPath);
const hasCvPdf = fs.existsSync(cvPdfPath);

const sections = [
  { label: 'Résumé', href: '#resume' },
  { label: 'Curriculum Vitae', href: '#cv' },
  { label: 'Contact', href: '#contact' },
];
---

<BaseLayout
  title="Curriculum Vitae & Résumé"
  description="Academic background, publications, technical competencies, and research experience of Fenil Modi."
>
  <Background slot="background" />
  <Nav currentPath="/cv" />
  <Dock sections={sections} />

  <main class="wrap" style="padding-top: clamp(100px, 14vh, 140px); padding-bottom: 60px;">
    <!-- HEADER & DOWNLOADS -->
    <header style="margin-bottom: clamp(40px, 6vw, 70px);">
      <div class="eyebrow"><span class="mono">Academic Record</span></div>
      <h1 class="page-title">Curriculum Vitae</h1>
      <p class="page-lead">
        Space systems researcher and software engineer specializing in orbital conjunction assessment and scientific data systems.
      </p>

      <div class="pdf-downloads">
        {hasResumePdf ? (
          <a href="/files/Fenil-Modi-Resume.pdf" download class="btn btn-pri">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download Résumé (PDF)
          </a>
        ) : (
          <button class="btn btn-disabled" disabled title="PDF will be available once uploaded">
            Résumé PDF (Pending Upload)
          </button>
        )}

        {hasCvPdf ? (
          <a href="/files/Fenil-Modi-CV.pdf" download class="btn">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download Full CV (PDF)
          </a>
        ) : (
          <button class="btn btn-disabled" disabled title="PDF will be available once uploaded">
            Full CV PDF (Pending Upload)
          </button>
        )}
      </div>
    </header>

    <!-- RÉSUMÉ DOCUMENT -->
    {ResumeContent && (
      <section id="resume" class="sec">
        <div class="sec-head">
          <div>
            <span class="mono sec-tag">One-Page Summary</span>
            <h2 class="sec-h2">Résumé</h2>
          </div>
        </div>
        <div class="doc" style="max-width: 800px; margin: 0 auto;">
          <ResumeContent />
        </div>
      </section>
    )}

    <!-- CV DOCUMENT -->
    {CvContent && (
      <section id="cv" class="sec">
        <div class="sec-head">
          <div>
            <span class="mono sec-tag">Comprehensive Record</span>
            <h2 class="sec-h2">Curriculum Vitae</h2>
          </div>
        </div>
        <div class="doc" style="max-width: 800px; margin: 0 auto;">
          <CvContent />
        </div>
      </section>
    )}

    <!-- FOOTER -->
    <Plate />
  </main>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    font-weight: 200;
    letter-spacing: -0.04em;
    color: var(--text-hi);
    line-height: 1.05;
    margin: 12px 0 16px;
  }
  .page-lead {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--text);
    line-height: 1.6;
    max-width: 62ch;
    margin: 0 0 24px;
  }
  .pdf-downloads {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--r-pill);
    font-size: 12.5px;
    text-decoration: none;
    border: 1px solid var(--line);
    color: var(--text-hi);
    background: rgba(232, 237, 247, 0.04);
    transition: all var(--t-fast) var(--ease);
    cursor: pointer;
  }
  .btn:hover:not(:disabled) {
    border-color: var(--line-hi);
    background: rgba(232, 237, 247, 0.08);
  }
  .btn-pri {
    border-color: rgba(0, 229, 255, 0.4);
    color: var(--cyan);
    background: rgba(0, 229, 255, 0.06);
  }
  .btn-pri:hover:not(:disabled) {
    border-color: var(--cyan);
    background: rgba(0, 229, 255, 0.12);
  }
  .btn-disabled {
    opacity: 0.5;
    cursor: not-allowed;
    color: var(--text-lo);
    border-style: dashed;
  }

  .sec {
    padding: clamp(40px, 6vw, 72px) 0;
    border-top: 1px solid var(--line);
  }
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: clamp(28px, 4vw, 48px);
    flex-wrap: wrap;
  }
  .sec-tag {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan);
    display: block;
    margin-bottom: 6px;
  }
  .sec-h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 200;
    letter-spacing: -0.03em;
    color: var(--text-hi);
    margin: 0;
  }

  @media (max-width: 480px) {
    .pdf-downloads {
      flex-direction: column;
    }
    .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
