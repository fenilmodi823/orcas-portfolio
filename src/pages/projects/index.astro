---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Background from '@/components/Background.astro';
import Nav from '@/components/Nav.astro';
import Dock from '@/components/Dock.astro';
import Plate from '@/components/Plate.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import RepoGrid from '@/components/RepoGrid.astro';
import SkillColumn from '@/components/SkillColumn.astro';
import Overlay from '@/components/Overlay.astro';
import { SKILLS } from '@/data/skills';

const sections = [
  { label: 'Featured', href: '#featured' },
  { label: 'Repositories', href: '#repositories' },
  { label: 'Skills', href: '#skills' },
  { label: 'Contact', href: '#contact' },
];
---

<BaseLayout
  title="Projects & Engineering Systems"
  description="Orbital mechanics, space debris tracking, quantum-enhanced cryptography, and healthtech platforms by Fenil Modi."
>
  <Background slot="background" />
  <Nav currentPath="/projects" />
  <Dock sections={sections} />
  <Overlay id="readme-overlay" />

  <main class="wrap" style="padding-top: clamp(100px, 14vh, 140px); padding-bottom: 60px;">
    <!-- HEADER -->
    <header style="margin-bottom: clamp(40px, 6vw, 70px);">
      <div class="eyebrow"><span class="mono">Engineered Systems</span></div>
      <h1 class="page-title">Projects & Systems</h1>
      <p class="page-lead">
        From orbital conjunction screening and celestial body propagation to quantum cryptography and full-stack health informatics.
      </p>
    </header>

    <!-- FEATURED PROJECTS -->
    <section id="featured" class="sec" style="border-top: none; padding-top: 0;">
      <div class="sec-head">
        <div>
          <span class="mono sec-tag">Core Systems</span>
          <h2 class="sec-h2">Featured Work</h2>
        </div>
      </div>

      <div class="projects-grid">
        <ProjectCard
          variant="feature"
          eyebrow="Primary Research System"
          title="ORCAS — Orbital Risk & Conjunction Assessment System"
          description="A dual-phase orbital safety platform replacing distance thresholds with collision probability. Features SGP4 propagation, B-plane covariance projection, and ML classification."
          tag="Python · Astrodynamics · SGP4"
          meta="Phase P1 Complete · ICSSIT 2026 Paper"
          href="/projects/orcas"
        />

        <ProjectCard
          variant="tall"
          eyebrow="Team Lead · Jan 2024–Present"
          title="Space Debris Tracking & Analysis System"
          description="Large-scale TLE ingestion and orbital trajectory propagation platform tracking 10,000+ objects across Low Earth Orbit using Skyfield, SPICE kernels, and PyVista 3D rendering."
          tag="Python · Skyfield · SPICE · React"
          meta="Silver Oak University Project"
          href="https://github.com/fenilmodi823/Space-Science"
        />

        <ProjectCard
          variant="tall"
          eyebrow="Course Research Project"
          title="Quantum-Enhanced AES Encryption"
          description="Quantum-random key generation via Qiskit integrated into AES cipher suites. Evaluated against PRNGs with the NIST SP 800-22 statistical test suite for entropy and avalanche characteristics."
          tag="Python · Qiskit · Cryptography"
          meta="Completed · NIST SP 800-22 Validated"
          href="https://github.com/fenilmodi823/Quantum-Enhanced-AES-Encryption"
        />

        <ProjectCard
          variant="half"
          eyebrow="Healthcare Informatics"
          title="Diablex Platform"
          description="Medical analytics dashboard handling noise reduction, outlier detection, and time-series normalization for 1,000+ daily continuous glucose measurements via FHIR APIs."
          tag="Node.js · React · MongoDB · FHIR"
          meta="Ongoing Platform"
          href="https://github.com/fenilmodi823/diablex-core"
        />

        <ProjectCard
          variant="half"
          eyebrow="Academic Repository"
          title="University Research & Lab Archives"
          description="Collection of computational coursework, numerical methods simulations, and machine learning labs completed during B.Tech at Silver Oak University."
          tag="Jupyter · Python · C++"
          meta="Academic Portfolio"
          href="https://github.com/fenilmodi823/University"
        />
      </div>
    </section>

    <!-- LIVE GITHUB REPOS -->
    <section id="repositories" class="sec">
      <div class="sec-head">
        <div>
          <span class="mono sec-tag">Open Source</span>
          <h2 class="sec-h2">GitHub Repositories</h2>
        </div>
      </div>

      <RepoGrid />
    </section>

    <!-- SKILLS MATRIX -->
    <section id="skills" class="sec">
      <div class="sec-head">
        <div>
          <span class="mono sec-tag">Competencies</span>
          <h2 class="sec-h2">Technical Skills & Tooling</h2>
        </div>
        <span class="mono sec-note">Propagators, Machine Learning, WebGL & Infrastructure</span>
      </div>

      <div class="skills-grid">
        {SKILLS.map((group) => (
          <SkillColumn group={group} />
        ))}
      </div>
    </section>

    <!-- FOOTER -->
    <Plate />
  </main>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    font-weight: 200;
    letter-spacing: -0.04em;
    color: var(--text-hi);
    line-height: 1.05;
    margin: 12px 0 16px;
  }
  .page-lead {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--text);
    line-height: 1.6;
    max-width: 62ch;
    margin: 0;
  }
  .sec {
    padding: clamp(40px, 6vw, 72px) 0;
    border-top: 1px solid var(--line);
  }
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: clamp(28px, 4vw, 48px);
    flex-wrap: wrap;
  }
  .sec-tag {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan);
    display: block;
    margin-bottom: 6px;
  }
  .sec-h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 200;
    letter-spacing: -0.03em;
    color: var(--text-hi);
    margin: 0;
  }
  .sec-note {
    font-size: 11px;
    color: var(--text-lo);
    letter-spacing: 0.08em;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(16px, 2.5vw, 28px);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(16px, 2.5vw, 24px);
  }
</style>
