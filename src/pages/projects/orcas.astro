---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Background from '@/components/Background.astro';
import Nav from '@/components/Nav.astro';
import Dock from '@/components/Dock.astro';
import Plate from '@/components/Plate.astro';
import PhaseRail from '@/components/PhaseRail.astro';
import MiniSimulation from '@/components/MiniSimulation.astro';

const orcasDoc = await getEntry('docs', 'orcas');
const { Content } = orcasDoc ? await render(orcasDoc) : { Content: null };

const sections = [
  { label: 'Overview', href: '#overview' },
  { label: 'Simulation', href: '#simulation' },
  { label: 'Phase Progress', href: '#phases' },
  { label: 'Case Study', href: '#case-study' },
  { label: 'Contact', href: '#contact' },
];
---

<BaseLayout
  title="ORCAS — Orbital Risk & Conjunction Assessment System"
  description="Probabilistic space debris conjunction assessment, SGP4 propagation, and historical collision reconstruction by Fenil Modi."
>
  <Background slot="background" />
  <Nav currentPath="/projects" />
  <Dock sections={sections} />

  <main class="wrap" style="padding-top: clamp(100px, 14vh, 140px); padding-bottom: 60px;">
    <!-- HEADER -->
    <section id="overview" style="margin-bottom: clamp(32px, 5vw, 56px);">
      <div class="eyebrow"><span class="mono">Primary Engineering Project</span></div>
      <h1 class="page-title">ORCAS</h1>
      <p class="page-subtitle mono">Orbital Risk & Conjunction Assessment System</p>
      <p class="page-lead">
        Replacing Euclidean distance thresholds with rigorous collision probabilities in Low Earth Orbit using SGP4 propagation, B-plane covariance projection, and Random Forest classification.
      </p>
    </section>

    <!-- INTERACTIVE MINI-SIMULATION -->
    <section id="simulation" class="sec" style="border-top: none; padding-top: 0;">
      <div class="sec-head">
        <div>
          <span class="mono sec-tag">Interactive Simulation</span>
          <h2 class="sec-h2">Two-Body Keplerian Orbit Viewer</h2>
        </div>
        <span class="mono sec-note">Live ECI Projection · Drag to Orbit · Click to Select</span>
      </div>

      <MiniSimulation />
    </section>

    <!-- PHASE RAIL PROGRESS -->
    <section id="phases" class="sec">
      <div class="sec-head">
        <div>
          <span class="mono sec-tag">Architecture Roadmap</span>
          <h2 class="sec-h2">Development Progress</h2>
        </div>
        <span class="mono sec-note">Verified Against Backend Milestones</span>
      </div>

      <PhaseRail />
    </section>

    <!-- CASE STUDY LONG-FORM DOC -->
    {Content && (
      <section id="case-study" class="sec">
        <div class="sec-head">
          <div>
            <span class="mono sec-tag">Complete System Record</span>
            <h2 class="sec-h2">Case Study & Validation</h2>
          </div>
        </div>
        <div class="doc" style="max-width: 820px; margin: 0 auto;">
          <Content />
        </div>
      </section>
    )}

    <!-- FOOTER -->
    <Plate />
  </main>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2.8rem, 7vw, 5.2rem);
    font-weight: 200;
    letter-spacing: -0.04em;
    color: var(--text-hi);
    line-height: 1;
    margin: 12px 0 8px;
  }
  .page-subtitle {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan);
    margin: 0 0 20px;
    display: block;
  }
  .page-lead {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--text);
    line-height: 1.65;
    max-width: 68ch;
    margin: 0;
  }
  .sec {
    padding: clamp(40px, 6vw, 72px) 0;
    border-top: 1px solid var(--line);
  }
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: clamp(24px, 3.5vw, 40px);
    flex-wrap: wrap;
  }
  .sec-tag {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan);
    display: block;
    margin-bottom: 6px;
  }
  .sec-h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 200;
    letter-spacing: -0.03em;
    color: var(--text-hi);
    margin: 0;
  }
  .sec-note {
    font-size: 11px;
    color: var(--text-lo);
    letter-spacing: 0.08em;
  }
</style>
